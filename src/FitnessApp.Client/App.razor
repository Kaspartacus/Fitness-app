@implements IDisposable
@inject FitnessApp.Client.Settings.ThemePreference Theme
@inject AuthenticationClient Authentication
@inject NavigationManager Navigation

@if (SessionRouting.ShowSessionGate(initializing || Theme.IsLoading, Navigation.Uri))
{
    <p class="status-message" role="status">Gendanner din session…</p>
}
else if (SessionRouting.ShowSessionGate(Authentication.IsUnavailable, Navigation.Uri))
{
    <main class="state-page"><section class="state-panel">
        <h1>Kunne ikke kontrollere din session</h1>
        <p>Kontrollér forbindelsen, og prøv igen.</p>
        <button class="button button-primary" @onclick="RetryAsync">Prøv igen</button>
        <button class="button button-secondary" @onclick="LogoutAsync">Log ud</button>
        <a href="/login">Log ind</a>
        <a href="/glemt-adgangskode">Glemt adgangskode?</a>
    </section></main>
}
else
{
<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly" NotFoundPage="typeof(Pages.NotFound)">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized Context="authenticationState">
                    @if (authenticationState.User.Identity?.IsAuthenticated is true)
                    {
                        <main class="state-page" aria-labelledby="forbidden-title">
                            <section class="state-panel">
                                <h1 id="forbidden-title">Ingen adgang</h1>
                                <p>Din bruger har ikke adgang til denne side.</p>
                                <a class="button button-primary" href="/">Gå til forsiden</a>
                            </section>
                        </main>
                    }
                    else
                    {
                        <RedirectToLogin />
                    }
                </NotAuthorized>
                <Authorizing>
                    <p class="status-message" role="status">Kontrollerer adgang…</p>
                </Authorizing>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
    </Router>
</CascadingAuthenticationState>

}

@code {
    private bool initializing = true;
    protected override async Task OnInitializedAsync()
    {
        Authentication.StateChanged += OnSessionChanged;
        Theme.Changed += OnSessionChanged;
        Navigation.LocationChanged += OnLocationChanged;
        await Theme.InitializeAsync();
        await RetryAsync();
    }
    private async Task RetryAsync()
    {
        initializing = true;
        try { await Authentication.InitializeAsync(); }
        finally { initializing = false; }
    }
    private Task LogoutAsync() => Authentication.LogoutAsync();
    private void OnSessionChanged() => _ = InvokeAsync(StateHasChanged);
    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs args) => OnSessionChanged();
    public void Dispose()
    {
        Authentication.StateChanged -= OnSessionChanged;
        Theme.Changed -= OnSessionChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
