@page "/login"
@inject AuthenticationClient Authentication
@inject NavigationManager Navigation

<PageTitle>Log ind</PageTitle>

<main class="auth-page" aria-labelledby="login-title">
    <section class="auth-panel">
        <BrandMark />
        <header class="auth-heading">
            <h1 id="login-title">Velkommen tilbage</h1>
            <p>Log ind for at fortsætte</p>
        </header>

        @if (Logout is "unconfirmed")
        {
            <p class="notice notice-warning" role="status">Du er logget ud lokalt. Serverlogout kunne ikke bekræftes.</p>
        }

        <EditForm Model="model" OnValidSubmit="LoginAsync" FormName="login" class="auth-form">
            <DataAnnotationsValidator />

            <div class="form-field">
                <label for="email">E-mail</label>
                <input id="email" @bind="model.Email" @bind:event="oninput" autocomplete="email" inputmode="email" placeholder="navn@eksempel.dk" />
                <ValidationMessage For="@(() => model.Email)" />
            </div>

            <div class="form-field">
                <label for="password">Adgangskode</label>
                <input id="password" type="password" @bind="model.Password" @bind:event="oninput" autocomplete="current-password" placeholder="Din adgangskode" />
                <ValidationMessage For="@(() => model.Password)" />
                <a class="field-action" href="/glemt-adgangskode">Glemt adgangskode?</a>
            </div>

            @if (errorMessage is not null)
            {
                <p class="notice notice-error" role="alert">@errorMessage</p>
            }

            <button class="button button-primary" type="submit" disabled="@isSubmitting">
                @(isSubmitting ? "Logger ind…" : "Log ind")
            </button>
        </EditForm>

        <p class="auth-alternative">Ny i FitnessApp? <a href="/registrer">Opret bruger</a></p>
    </section>
</main>

@code {
    [SupplyParameterFromQuery(Name = "logout")]
    public string? Logout { get; set; }

    private readonly FitnessApp.Contracts.Authentication.LoginRequest model = new();
    private bool isSubmitting;
    private string? errorMessage;

    private async Task LoginAsync()
    {
        if (isSubmitting)
        {
            return;
        }

        isSubmitting = true;
        errorMessage = null;

        try
        {
            errorMessage = await Authentication.LoginAsync(model);
            if (errorMessage is null)
            {
                Navigation.NavigateTo("/");
            }
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException)
        {
            errorMessage = "Der kunne ikke oprettes forbindelse. Prøv igen.";
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
