@page "/"
@attribute [Authorize]
@inject AuthenticationClient Authentication

<PageTitle>Hjem</PageTitle>

<main class="dashboard-page" aria-labelledby="home-title">
    @if (isLoading)
    {
        <section class="state-panel">
            <BrandMark />
            <h1 id="home-title">Indlæser…</h1>
            <p role="status">Kontrollerer din session.</p>
        </section>
    }
    else if (user is not null)
    {
        <header class="dashboard-header">
            <div>
                <p class="overline">FitnessApp</p>
                <h1 id="home-title">Hej, @user.DisplayName</h1>
                <p>Velkommen tilbage.</p>
            </div>
            <button class="button button-quiet" type="button" @onclick="LogoutAsync" disabled="@isLoggingOut">
                @(isLoggingOut ? "Logger ud…" : "Log ud")
            </button>
        </header>

        <section class="dashboard-grid" aria-label="Din konto">
            <article class="dashboard-card">
                <p class="overline">Konto</p>
                <h2>Du er logget ind</h2>
                <p>@user.Email</p>
            </article>

            <article class="dashboard-card">
                <p class="overline">Træning</p>
                <h2>Styrketræning</h2>
                <p>Opret og tilpas dine egne programmer med øvelser.</p>
                <a class="button button-primary button-link" href="/styrke">Styrketræning</a>
            </article>

            <article class="dashboard-card dashboard-card-accent">
                <p class="overline">Træning</p>
                <h2>Løb</h2>
                <p>Opret en personlig løbeplan, følg dine planlagte ture, og registrér dine resultater.</p>
                <a class="button button-primary button-link" href="/loeb">Åbn løb</a>
            </article>

            @if (user.Roles.Contains("Admin", StringComparer.Ordinal))
            {
                <article class="dashboard-card dashboard-card-accent">
                    <p class="overline">Administration</p>
                    <h2>Brugeranmodninger</h2>
                    <p>Gennemgå nye registreringer, og godkend eller afvis adgang.</p>
                    <a class="button button-primary button-link" href="/administration/registreringer">Åbn administration</a>
                </article>
            }
        </section>
    }
    else if (errorMessage is not null)
    {
        <section class="state-panel">
            <h1 id="home-title">Kunne ikke indlæse</h1>
            <p class="notice notice-error" role="alert">@errorMessage</p>
            <button class="button button-secondary" type="button" @onclick="LoadAsync" disabled="@isRequestInProgress">
                @(isRequestInProgress ? "Prøver igen…" : "Prøv igen")
            </button>
        </section>
    }
</main>

@code {
    private FitnessApp.Contracts.Authentication.AuthenticatedUserResponse? user;
    private bool isLoading = true;
    private bool isLoggingOut;
    private bool isRequestInProgress;
    private string? errorMessage;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        if (isRequestInProgress)
        {
            return;
        }

        isRequestInProgress = true;
        isLoading = true;
        errorMessage = null;

        try
        {
            var result = await Authentication.GetCurrentUserAsync();
            if (result.Status is CurrentUserStatus.Succeeded)
            {
                user = result.User;
            }
            else if (result.Status is CurrentUserStatus.Unavailable)
            {
                user = null;
                errorMessage = "Vi kunne ikke hente din konto. Kontrollér forbindelsen, og prøv igen.";
            }
        }
        finally
        {
            isLoading = false;
            isRequestInProgress = false;
        }
    }

    private async Task LogoutAsync()
    {
        if (isLoggingOut)
        {
            return;
        }

        isLoggingOut = true;
        try
        {
            await Authentication.LogoutAsync();
        }
        finally
        {
            isLoggingOut = false;
        }
    }
}
