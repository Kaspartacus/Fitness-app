@page "/nulstil-adgangskode"
@inject PasswordResetClient PasswordReset

<PageTitle>Nulstil adgangskode</PageTitle>

<main class="auth-page" aria-labelledby="reset-password-title">
    <section class="auth-panel auth-panel-long">
        @if (isSucceeded)
        {
            <div class="brand-mark brand-mark-success" aria-hidden="true">✓</div>
            <header class="auth-heading">
                <h1 id="reset-password-title">Adgangskoden er ændret</h1>
                <p>Alle tidligere login-sessioner er blevet afsluttet.</p>
            </header>
            <p class="confirmation-copy" role="status">Du bliver ikke logget ind automatisk. Log ind igen med din nye adgangskode.</p>
            <a class="button button-primary button-link" href="/login">Gå til login</a>
        }
        else if (isInvalidLink)
        {
            <div class="brand-mark brand-mark-muted" aria-hidden="true">!</div>
            <header class="auth-heading">
                <h1 id="reset-password-title">Linket kan ikke bruges</h1>
                <p>Det er ugyldigt, udløbet eller allerede anvendt.</p>
            </header>
            <a class="button button-primary button-link" href="/glemt-adgangskode">Anmod om et nyt link</a>
            <a class="back-link centered-link" href="/login">Tilbage til login</a>
        }
        else
        {
            <a class="back-link" href="/login" aria-label="Tilbage til login">← Tilbage</a>
            <BrandMark />
            <header class="auth-heading">
                <h1 id="reset-password-title">Vælg en ny adgangskode</h1>
                <p>Linket kan kun bruges én gang. Udløbstiden står i mailen.</p>
            </header>

            <EditForm Model="model" OnValidSubmit="ResetAsync" FormName="reset-password" class="auth-form">
                <DataAnnotationsValidator />
                <div class="form-field">
                    <label for="new-password">Ny adgangskode</label>
                    <input id="new-password" type="password" @bind="model.NewPassword" @bind:event="oninput" autocomplete="new-password" maxlength="128" placeholder="Mindst 12 tegn" />
                    <ValidationMessage For="@(() => model.NewPassword)" />
                    <p class="field-hint">Brug mindst 12 tegn med små og store bogstaver, et tal og et specialtegn.</p>
                </div>
                <div class="form-field">
                    <label for="reset-confirm-password">Gentag adgangskode</label>
                    <input id="reset-confirm-password" type="password" @bind="model.ConfirmPassword" @bind:event="oninput" autocomplete="new-password" maxlength="128" placeholder="Gentag adgangskoden" />
                    <ValidationMessage For="@(() => model.ConfirmPassword)" />
                </div>

                @if (errorMessage is not null)
                {
                    <p class="notice notice-error" role="alert">@errorMessage</p>
                }

                <button class="button button-primary" type="submit" disabled="@isSubmitting">
                    @(isSubmitting ? "Gemmer…" : "Gem ny adgangskode")
                </button>
            </EditForm>
        }
    </section>
</main>

@code {
    [SupplyParameterFromQuery(Name = "email")]
    public string? Email { get; set; }

    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    private readonly FitnessApp.Contracts.Authentication.ResetPasswordRequest model = new();
    private bool isSubmitting;
    private bool isInvalidLink;
    private bool isSucceeded;
    private bool hasReadLink;
    private string? errorMessage;

    protected override void OnParametersSet()
    {
        if (hasReadLink && model.Email == Email && model.Token == Token)
            return;

        hasReadLink = true;
        model.Email = Email ?? string.Empty;
        model.Token = Token ?? string.Empty;
        model.NewPassword = string.Empty;
        model.ConfirmPassword = string.Empty;
        isSucceeded = false;
        errorMessage = null;
        isInvalidLink = !IsValidLinkProperty(nameof(model.Email), model.Email) ||
            !IsValidLinkProperty(nameof(model.Token), model.Token);
    }

    private bool IsValidLinkProperty(string name, string value) =>
        System.ComponentModel.DataAnnotations.Validator.TryValidateProperty(
            value,
            new System.ComponentModel.DataAnnotations.ValidationContext(model) { MemberName = name },
            null);

    private async Task ResetAsync()
    {
        if (isSubmitting)
        {
            return;
        }

        isSubmitting = true;
        errorMessage = null;
        try
        {
            var result = await PasswordReset.ResetAsync(model);
            switch (result.Status)
            {
                case PasswordResetSubmissionStatus.Succeeded:
                    isSucceeded = true;
                    break;
                case PasswordResetSubmissionStatus.InvalidLink:
                    isInvalidLink = true;
                    break;
                default:
                    errorMessage = result.ErrorMessage;
                    break;
            }
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException)
        {
            errorMessage = "Der kunne ikke oprettes forbindelse. Prøv igen.";
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
