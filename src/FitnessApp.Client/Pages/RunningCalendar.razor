@page "/kalender"
@attribute [Authorize]
@implements IDisposable
@using System.Globalization
@using FitnessApp.Client.Calendar
@using FitnessApp.Client.Running
@using FitnessApp.Contracts.Calendar
@using FitnessApp.Contracts.Running
@inject CalendarClient Calendar
@inject RunningClient Running
@inject NavigationManager Navigation
@inject IJSRuntime JavaScript

<PageTitle>Kalender</PageTitle>

<main class="strength-app running-app strength-with-bottom-nav calendar-app" aria-labelledby="calendar-title">
    <header class="strength-back-header calendar-page-header">
        <a class="strength-icon-button" href="/" aria-label="Tilbage til hjem" title="Tilbage til hjem">←</a>
        <h1 id="calendar-title">Kalender</h1>
        <button class="calendar-header-today" type="button" @onclick="TodayAsync" disabled="@IsShowingToday"
                aria-label="Gå til i dag">I dag</button>
    </header>

    <section class="strength-section calendar-week-section" aria-label="Delt kalender for løb og styrketræning">
        <div class="calendar-week-controls">
            <button class="running-calendar-control" type="button" @onclick="PreviousWeekAsync" disabled="@isLoading"
                    aria-label="Forrige uge" title="Forrige uge">‹</button>
            <RunningDatePicker Id="calendar-week-picker" Label="Vælg uge eller dato" ModalTitle="Vælg uge"
                               Value="@selectedDate" ValueChanged="SelectDateFromPickerAsync" Disabled="@isLoading"
                               TriggerText="@WeekLabel" TriggerClass="calendar-week-trigger" CompactNavigation="true" ShowTodayAction="true" />
            <button class="running-calendar-control" type="button" @onclick="NextWeekAsync" disabled="@isLoading"
                    aria-label="Næste uge" title="Næste uge">›</button>
        </div>

        @if (isLoading)
        {
            <p class="strength-feedback" role="status">Indlæser kalender…</p>
        }
        else if (error is not null)
        {
            <section class="strength-status-card" role="alert">
                <p>@error</p>
                <button class="strength-secondary-button" type="button" @onclick="LoadAsync">Prøv igen</button>
            </section>
        }
        else
        {
            <div class="calendar-week-grid" @ref="calendarGrid" aria-label="@WeekLabel">
                @foreach (var calendarDate in WeekDates)
                {
                    <button @key="calendarDate" class="@CellClass(calendarDate)" type="button" data-calendar-day
                            @ref="dayButtons[calendarDate]"
                            @onclick="() => SelectDateAsync(calendarDate)"
                            @onkeydown="args => HandleDayKeyDownAsync(args, calendarDate)"
                            aria-pressed="@(calendarDate == selectedDate)" aria-current="@(calendarDate == BrowserToday ? "date" : null)"
                            tabindex="@(FocusDate == calendarDate ? "0" : "-1")" aria-label="@DayLabel(calendarDate)">
                        <span class="calendar-weekday-label">@ShortWeekday(calendarDate)</span>
                        <strong class="calendar-weekday-number">@calendarDate.Day</strong>
                        <span class="calendar-day-indicators" aria-hidden="true">
                            @foreach (var indicator in IndicatorsOn(calendarDate))
                            {
                                <i class="@indicator"></i>
                            }
                        </span>
                    </button>
                }
            </div>

            <section class="running-calendar-selected calendar-selected" aria-live="polite" aria-labelledby="selected-date-title">
                <div class="strength-section-row calendar-selected-heading">
                    <div>
                        <p class="strength-overline">Valgt dag</p>
                        <h2 id="selected-date-title">@RunningPresentation.Date(selectedDate)</h2>
                        <p class="calendar-activity-count">@ActivityCountText</p>
                    </div>
                    @if (CanRegisterRun)
                    {
                        <a class="strength-text-action" href="@ManualLogHref()">Registrer løb</a>
                    }
                </div>

                @if (ActivitiesOn(selectedDate).Count == 0 && RelationshipsOn(selectedDate).Count == 0)
                {
                    <div class="strength-empty-compact">
                        <p>Ingen aktiviteter på denne dag.</p>
                        @if (selectedDate > BrowserToday)
                        {
                            <p>Et manuelt løb kan først registreres med en faktisk dato i dag eller tidligere.</p>
                        }
                    </div>
                }
                else
                {
                    @if (ActivitiesOn(selectedDate).Count > 0)
                    {
                        <div class="calendar-activity-list">
                            @foreach (var activity in ActivitiesOn(selectedDate))
                            {
                                <button class="@ActivityClass(activity)" type="button" @key="ActivityKey(activity)"
                                        @onclick="() => OpenActivityActions(activity)" aria-label="@ActivityActionLabel(activity)">
                                    <span class="calendar-activity-kind">@ActivityTypeText(activity)</span>
                                    <span class="calendar-activity-copy">
                                        <strong>@ActivityTitle(activity)</strong>
                                        <span>@ActivityDetail(activity)</span>
                                        <span class="@ActivityStatusClass(activity)">@ActivityStatusText(activity)</span>
                                    </span>
                                    <span class="running-session-chevron" aria-hidden="true">›</span>
                                </button>
                            }
                        </div>
                    }

                    @if (RelationshipsOn(selectedDate).Count > 0)
                    {
                        <section class="calendar-relationships" aria-label="Oprindeligt planlagte løb">
                            <p class="strength-overline">Oprindeligt planlagt</p>
                            @foreach (var completed in RelationshipsOn(selectedDate))
                            {
                                <button class="calendar-relationship-row" type="button" @key="ActivityKey(completed)"
                                        @onclick="() => OpenActivityActions(completed)" aria-label="@ActivityActionLabel(completed)">
                                    <span><strong>@ActivityTitle(completed)</strong><small>Gennemført @RunningPresentation.ShortDate(completed.Date)</small></span>
                                    <span class="running-session-chevron" aria-hidden="true">›</span>
                                </button>
                            }
                        </section>
                    }
                }
            </section>
        }
    </section>

    <ModalDialog IsOpen="@(actionActivity is not null)" Title="@ActionTitle" Description="@ActionDescription"
                 InitialFocusSelector="[data-calendar-primary]" DismissOnBackdrop="@(!isCancellingStartedRun)"
                 DismissOnEscape="@(!isCancellingStartedRun)" ShowCloseButton="@(!isCancellingStartedRun)" OnDismiss="CloseActivityActions">
        @if (actionActivity is { } activity)
        {
            <div class="calendar-action-summary">
                <p class="strength-overline">@ActivityStatusText(activity)</p>
                <strong>@ActivityTitle(activity)</strong>
                <span>@ActivityDetail(activity)</span>
            </div>

            @if (actionError is not null)
            {
                <p class="strength-field-error" role="alert">@actionError</p>
            }

            <div class="calendar-action-list">
                @if (IsPlannedRunning(activity))
                {
                    <a class="strength-primary-button" data-calendar-primary href="@RunningRegistrationHref(activity)">Registrer løbetur</a>
                    <a class="strength-outline-button" href="@RunningScheduleHref()">Flyt kommende løbedage</a>
                    <a class="strength-outline-button" href="@ActivityDetailHref(activity)">Se detaljer</a>
                }
                else if (IsStartedRunning(activity))
                {
                    @if (!isCancellingStartedRun)
                    {
                        <a class="strength-primary-button" data-calendar-primary href="@RunningActiveHref(activity)">Fortsæt løbetur</a>
                        <a class="strength-outline-button" href="@ActivityDetailHref(activity)">Se detaljer</a>
                    }
                    <button class="strength-danger-button" type="button" @onclick="CancelStartedRunAsync" disabled="@isCancellingStartedRun">
                        @(isCancellingStartedRun ? "Afbryder…" : "Afbryd løbetur")
                    </button>
                }
                else if (IsPlannedStrength(activity))
                {
                    <a class="strength-primary-button" data-calendar-primary href="@StrengthActiveHref(activity)">Start træning</a>
                    <a class="strength-outline-button" href="@StrengthScheduleHref(activity)">Flyt kommende træninger</a>
                    <a class="strength-outline-button" href="@ActivityDetailHref(activity)">Se detaljer</a>
                }
                else if (activity.State == CalendarActivityState.Completed)
                {
                    <a class="strength-primary-button" data-calendar-primary href="@ActivityDetailHref(activity)">
                        @(activity.Type == CalendarActivityType.Running ? "Se resultat" : "Se detaljer")
                    </a>
                    @if (activity.Type == CalendarActivityType.Running && activity.RunningResultId is { } resultId)
                    {
                        <a class="strength-outline-button" href="@WithCalendarState($"/loeb/resultater/{resultId}/ret")">Ret resultat</a>
                    }
                }
            </div>
        }
    </ModalDialog>

    <StrengthBottomNavigation Active="calendar" CalendarHref="@CalendarHref" />
</main>

@code {
    private static readonly string[] WeekdayLabels = ["Man", "Tir", "Ons", "Tor", "Fre", "Lør", "Søn"];
    private DateOnly weekStart = RunningPresentation.Monday(BrowserToday);
    private DateOnly selectedDate = BrowserToday;
    private Dictionary<DateOnly, List<CalendarActivityResponse>> activitiesByDate = [];
    private Dictionary<DateOnly, List<CalendarActivityResponse>> relationshipsByDate = [];
    private readonly Dictionary<DateOnly, ElementReference> dayButtons = [];
    private ElementReference calendarGrid;
    private CancellationTokenSource? loadCancellation;
    private int loadRequestVersion;
    private bool hasRouteState;
    private bool isLoading;
    private string? error;
    private DateOnly? keyboardFocusDate;
    private DateOnly? pendingFocusDate;
    private CalendarActivityResponse? actionActivity;
    private string? actionError;
    private bool isCancellingStartedRun;

    [SupplyParameterFromQuery(Name = "maaned")] public string? RequestedMonth { get; set; }
    [SupplyParameterFromQuery(Name = "dato")] public string? RequestedDate { get; set; }

    private IEnumerable<DateOnly> WeekDates
    {
        get
        {
            for (var offset = 0; offset < 7; offset++)
            {
                yield return weekStart.AddDays(offset);
            }
        }
    }

    private bool CanRegisterRun => selectedDate >= EarliestResultDate && selectedDate <= BrowserToday;
    private bool IsShowingToday => selectedDate == BrowserToday;
    private bool IsInWeek(DateOnly date) => date >= weekStart && date <= weekStart.AddDays(6);
    private DateOnly FocusDate => keyboardFocusDate is { } focused && IsInWeek(focused) ? focused : selectedDate;
    private string WeekLabel => $"Uge {ISOWeek.GetWeekOfYear(selectedDate.ToDateTime(TimeOnly.MinValue))}";
    private string CalendarHref => CalendarRoute.Path(MonthStart(selectedDate), selectedDate);
    private string ActionTitle => actionActivity is { } activity ? ActivityTitle(activity) : "Aktivitet";
    private string? ActionDescription => actionActivity is { } activity
        ? $"{RunningPresentation.Date(activity.Date)} · {ActivityStatusText(activity)}"
        : null;

    private string ActivityCountText
    {
        get
        {
            var activities = ActivitiesOn(selectedDate).Count;
            var relationships = RelationshipsOn(selectedDate).Count;
            var actualText = activities switch
            {
                0 => "Ingen aktiviteter på denne dato",
                1 => "1 aktivitet på denne dato",
                _ => $"{activities} aktiviteter på denne dato"
            };
            return relationships == 0
                ? actualText
                : relationships == 1
                    ? $"{actualText} · 1 løb er gennemført på en anden dato"
                    : $"{actualText} · {relationships} løb er gennemført på andre datoer";
        }
    }

    protected override Task OnParametersSetAsync()
    {
        var nextSelectedDate = BrowserToday;
        if (CalendarRoute.TryParseState(RequestedMonth, RequestedDate, out _, out var requestedDate))
        {
            nextSelectedDate = requestedDate;
        }

        if (hasRouteState && nextSelectedDate == selectedDate)
        {
            return Task.CompletedTask;
        }

        hasRouteState = true;
        selectedDate = nextSelectedDate;
        weekStart = RunningPresentation.Monday(nextSelectedDate);
        keyboardFocusDate = nextSelectedDate;
        dayButtons.Clear();
        return LoadAsync();
    }

    private Task PreviousWeekAsync() => SetCalendarStateAsync(selectedDate.AddDays(-7));

    private Task NextWeekAsync() => SetCalendarStateAsync(selectedDate.AddDays(7));

    private Task TodayAsync() => SetCalendarStateAsync(BrowserToday);

    private Task SelectDateAsync(DateOnly date) => SetCalendarStateAsync(date);

    private Task SelectDateFromPickerAsync(DateOnly? date) => date is { } selected
        ? SetCalendarStateAsync(selected)
        : Task.CompletedTask;

    private async Task SetCalendarStateAsync(DateOnly nextSelectedDate)
    {
        var nextWeekStart = RunningPresentation.Monday(nextSelectedDate);
        var rangeChanged = nextWeekStart != weekStart;
        selectedDate = nextSelectedDate;
        weekStart = nextWeekStart;
        keyboardFocusDate = nextSelectedDate;
        pendingFocusDate = nextSelectedDate;
        dayButtons.Clear();
        CloseActivityActions();
        Navigation.NavigateTo(CalendarRoute.Path(MonthStart(selectedDate), selectedDate), replace: true);
        if (rangeChanged)
        {
            await LoadAsync();
        }
    }

    private async Task HandleDayKeyDownAsync(KeyboardEventArgs args, DateOnly date)
    {
        var nextDate = args.Key switch
        {
            "ArrowLeft" => date.AddDays(-1),
            "ArrowRight" => date.AddDays(1),
            "ArrowUp" => date.AddDays(-7),
            "ArrowDown" => date.AddDays(7),
            "Home" => weekStart,
            "End" => weekStart.AddDays(6),
            _ => default
        };
        if (nextDate == default)
        {
            return;
        }

        await SetCalendarStateAsync(nextDate);
    }

    private async Task LoadAsync()
    {
        var requestedWeekStart = weekStart;
        var requestVersion = ++loadRequestVersion;
        loadCancellation?.Cancel();
        loadCancellation?.Dispose();
        loadCancellation = new CancellationTokenSource();
        isLoading = true;
        error = null;
        var response = await Calendar.GetRangeAsync(requestedWeekStart, requestedWeekStart.AddDays(6), loadCancellation.Token);
        if (requestVersion != loadRequestVersion || requestedWeekStart != weekStart)
        {
            return;
        }

        if (response.Succeeded && response.Value is { } range)
        {
            var end = requestedWeekStart.AddDays(6);
            activitiesByDate = range.Activities
                .Where(activity => activity.Date >= requestedWeekStart && activity.Date <= end)
                .GroupBy(activity => activity.Date)
                .ToDictionary(group => group.Key, group => group.ToList());
            relationshipsByDate = range.Activities
                .Where(activity => activity.PlannedDate is { } plannedDate && plannedDate != activity.Date &&
                                   plannedDate >= requestedWeekStart && plannedDate <= end)
                .GroupBy(activity => activity.PlannedDate!.Value)
                .ToDictionary(group => group.Key, group => group.ToList());
        }
        else if (!response.IsCanceled)
        {
            activitiesByDate = [];
            relationshipsByDate = [];
            error = response.Error ?? "Kalenderen kunne ikke indlæses. Prøv igen.";
        }

        isLoading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (isLoading || error is not null)
        {
            return;
        }

        await JavaScript.InvokeVoidAsync("fitnessCalendar.bindKeyboardNavigation", calendarGrid);
        if (pendingFocusDate is not { } focusDate || !dayButtons.TryGetValue(focusDate, out var element))
        {
            return;
        }

        pendingFocusDate = null;
        await JavaScript.InvokeVoidAsync("fitnessCalendar.focus", element);
    }

    private IReadOnlyList<CalendarActivityResponse> ActivitiesOn(DateOnly date) => activitiesByDate.GetValueOrDefault(date) ?? [];

    private IReadOnlyList<CalendarActivityResponse> RelationshipsOn(DateOnly date) => relationshipsByDate.GetValueOrDefault(date) ?? [];

    private IReadOnlyList<string> IndicatorsOn(DateOnly date)
    {
        var indicators = new List<string>();
        if (ActivitiesOn(date).Any(activity => activity.Type == CalendarActivityType.Running && activity.State == CalendarActivityState.Completed))
        {
            indicators.Add("calendar-day-indicator is-running is-completed");
        }
        else if (ActivitiesOn(date).Any(activity => activity.Type == CalendarActivityType.Running && activity.State == CalendarActivityState.Started))
        {
            indicators.Add("calendar-day-indicator is-running is-started");
        }
        else if (ActivitiesOn(date).Any(activity => activity.Type == CalendarActivityType.Running))
        {
            indicators.Add("calendar-day-indicator is-running");
        }

        if (ActivitiesOn(date).Any(activity => activity.Type == CalendarActivityType.Strength && activity.State == CalendarActivityState.Completed))
        {
            indicators.Add("calendar-day-indicator is-strength is-completed");
        }
        else if (ActivitiesOn(date).Any(activity => activity.Type == CalendarActivityType.Strength))
        {
            indicators.Add("calendar-day-indicator is-strength");
        }

        if (RelationshipsOn(date).Count > 0)
        {
            indicators.Add("calendar-day-indicator is-related");
        }

        return indicators;
    }

    private string CellClass(DateOnly date) => $"calendar-weekday{(date == BrowserToday ? " is-today" : "")}{(date == selectedDate ? " is-selected" : "")}";

    private string DayLabel(DateOnly date)
    {
        var activities = ActivitiesOn(date).Count;
        var relationships = RelationshipsOn(date).Count;
        var description = activities switch
        {
            0 => "ingen aktiviteter",
            1 => "1 aktivitet",
            _ => $"{activities} aktiviteter"
        };
        if (relationships > 0)
        {
            description += relationships == 1
                ? "; 1 løb er gennemført på en anden dag"
                : $"; {relationships} løb er gennemført på andre dage";
        }

        return $"{RunningPresentation.Date(date)}: {description}";
    }

    private void OpenActivityActions(CalendarActivityResponse activity)
    {
        actionActivity = activity;
        actionError = null;
    }

    private void CloseActivityActions()
    {
        if (isCancellingStartedRun)
        {
            return;
        }

        actionActivity = null;
        actionError = null;
    }

    private async Task CancelStartedRunAsync()
    {
        if (isCancellingStartedRun || actionActivity?.RunningSessionId is not { } sessionId)
        {
            return;
        }

        isCancellingStartedRun = true;
        actionError = null;
        var response = await Running.CancelSessionAsync(sessionId);
        isCancellingStartedRun = false;
        if (!response.Succeeded)
        {
            actionError = response.Error ?? "Løbeturen kunne ikke afbrydes. Prøv igen.";
            return;
        }

        pendingFocusDate = selectedDate;
        CloseActivityActions();
        await LoadAsync();
    }

    private string? ActivityDetailHref(CalendarActivityResponse activity)
    {
        if (activity.RunningResultId is { } resultId)
        {
            return WithCalendarState($"/loeb/resultater/{resultId}");
        }

        if (activity.RunningSessionId is { } sessionId)
        {
            return WithCalendarState($"/loeb/plan/{sessionId}");
        }

        if (activity.StrengthCompletionId is { } completionId)
        {
            return WithCalendarState($"/styrke/resultater/{completionId}");
        }

        if (activity.StrengthProgramId is { } programId)
        {
            return WithCalendarState($"/styrke/{programId}");
        }

        return CalendarHref;
    }

    private string RunningRegistrationHref(CalendarActivityResponse activity) => activity.RunningSessionId is { } sessionId
        ? WithCalendarState($"/loeb/plan/{sessionId}/registrer")
        : ManualLogHref();

    private string RunningActiveHref(CalendarActivityResponse activity) => activity.RunningSessionId is { } sessionId
        ? WithCalendarState($"/loeb/plan/{sessionId}/aktiv")
        : CalendarHref;

    private string StrengthActiveHref(CalendarActivityResponse activity) =>
        activity.StrengthProgramId is { } programId && activity.StrengthWorkoutId is { } workoutId
            ? WithCalendarState($"/styrke/{programId}/træninger/{workoutId}/aktiv")
            : CalendarHref;

    private string StrengthScheduleHref(CalendarActivityResponse activity) => activity.StrengthProgramId is { } programId
        ? WithCalendarState($"/styrke/{programId}/plan")
        : CalendarHref;

    private string RunningScheduleHref() => WithCalendarState("/loeb/planlaeg");

    private string ManualLogHref() => CalendarRoute.ManualRunningPath(MonthStart(selectedDate), selectedDate);

    private string WithCalendarState(string path) => CalendarRoute.AppendState(path, MonthStart(selectedDate), selectedDate);

    private static bool IsPlannedRunning(CalendarActivityResponse activity) =>
        activity.Type == CalendarActivityType.Running && activity.State == CalendarActivityState.Planned && activity.RunningSessionId is not null;

    private static bool IsStartedRunning(CalendarActivityResponse activity) =>
        activity.Type == CalendarActivityType.Running && activity.State == CalendarActivityState.Started && activity.RunningSessionId is not null;

    private static bool IsPlannedStrength(CalendarActivityResponse activity) =>
        activity.Type == CalendarActivityType.Strength && activity.State == CalendarActivityState.Planned &&
        activity.StrengthProgramId is not null && activity.StrengthWorkoutId is not null;

    private static string ActivityKey(CalendarActivityResponse activity) =>
        $"{activity.Date:yyyy-MM-dd}-{activity.Type}-{activity.State}-{activity.Id}";

    private static string ActivityTypeText(CalendarActivityResponse activity) => activity.Type == CalendarActivityType.Running ? "Løb" : "Styrke";

    private static string ActivityTitle(CalendarActivityResponse activity) => activity.Type switch
    {
        CalendarActivityType.Running when activity.RunningKind is { } kind => KindName(kind),
        CalendarActivityType.Running => "Manuelt løb",
        _ => activity.Title
    };

    private static string ActivityDetail(CalendarActivityResponse activity)
    {
        if (activity.Type == CalendarActivityType.Strength)
        {
            return activity.State == CalendarActivityState.Completed ? "Gennemført styrketræning" : "Planlagt styrketræning";
        }

        if (activity.State != CalendarActivityState.Completed)
        {
            return RunningPresentation.Distance(activity.PlannedDistanceKm);
        }

        var values = new List<string>();
        if (activity.ActualDistanceKm is not null)
        {
            values.Add(RunningPresentation.Distance(activity.ActualDistanceKm));
        }
        if (activity.ActualDurationSeconds is not null)
        {
            values.Add(RunningPresentation.Duration(activity.ActualDurationSeconds));
        }
        if (activity.PlannedDate is { } plannedDate && plannedDate != activity.Date)
        {
            values.Add($"Planlagt {RunningPresentation.ShortDate(plannedDate)}");
        }

        return values.Count == 0 ? "Gennemført uden målinger" : string.Join(" · ", values);
    }

    private static string ActivityClass(CalendarActivityResponse activity) =>
        $"calendar-activity-row is-{(activity.Type == CalendarActivityType.Running ? "running" : "strength")} is-{activity.State.ToString().ToLowerInvariant()}";

    private static string ActivityStatusClass(CalendarActivityResponse activity) =>
        $"calendar-activity-status is-{activity.State.ToString().ToLowerInvariant()}";

    private static string ActivityStatusText(CalendarActivityResponse activity) => activity.State switch
    {
        CalendarActivityState.Completed => "Gennemført",
        CalendarActivityState.Started => "I gang",
        _ => "Planlagt"
    };

    private static string ActivityActionLabel(CalendarActivityResponse activity) =>
        $"Åbn muligheder for {ActivityTypeText(activity)} {ActivityTitle(activity)}, {ActivityDetail(activity)}, " +
        $"{ActivityStatusText(activity)}, {RunningPresentation.Date(activity.Date)}";

    private static string ShortWeekday(DateOnly date) => WeekdayLabels[((int)date.DayOfWeek + 6) % 7];

    private static string KindName(RunningSessionKind kind) => kind switch
    {
        RunningSessionKind.Easy => "Rolig tur",
        RunningSessionKind.Tempo => "Tempotur",
        RunningSessionKind.Intervals => "Intervaller",
        _ => "Lang tur"
    };

    private static DateOnly MonthStart(DateOnly value) => new(value.Year, value.Month, 1);
    private static DateOnly BrowserToday => RunningPresentation.CopenhagenToday;
    private static DateOnly EarliestResultDate => new(2000, 1, 1);

    public void Dispose()
    {
        loadCancellation?.Cancel();
        loadCancellation?.Dispose();
    }
}
