@page "/kalender"
@attribute [Authorize]
@implements IDisposable
@using System.Globalization
@using FitnessApp.Client.Calendar
@using FitnessApp.Client.Running
@using FitnessApp.Contracts.Calendar
@using FitnessApp.Contracts.Running
@inject CalendarClient Calendar
@inject NavigationManager Navigation
@inject IJSRuntime JavaScript

<PageTitle>Kalender</PageTitle>

<main class="strength-app running-app strength-with-bottom-nav calendar-app" aria-labelledby="calendar-title">
    <header class="strength-back-header">
        <a class="strength-icon-button" href="/" aria-label="Tilbage til hjem" title="Tilbage til hjem">←</a>
        <h1 id="calendar-title">Kalender</h1>
        @if (CanRegisterRun)
        {
            <a class="strength-icon-button" href="@ManualLogHref()" aria-label="Registrer løb på den valgte dato" title="Registrer løb">＋</a>
        }
        else
        {
            <span class="strength-header-spacer" aria-hidden="true"></span>
        }
    </header>

    <section class="strength-section" aria-label="Delt kalender for løb og styrketræning">
        <div class="calendar-month-controls">
            <button class="running-calendar-control" type="button" @onclick="PreviousMonthAsync" disabled="@isLoading"
                    aria-label="Forrige måned" title="Forrige måned">‹</button>
            <div>
                <h2 id="calendar-month-title">@RunningPresentation.Month(month)</h2>
                <button class="calendar-today-button" type="button" @onclick="TodayAsync" disabled="@(isLoading || IsShowingToday)"
                        aria-label="Gå til i dag">I dag</button>
            </div>
            <button class="running-calendar-control" type="button" @onclick="NextMonthAsync" disabled="@isLoading"
                    aria-label="Næste måned" title="Næste måned">›</button>
        </div>

        <div class="running-calendar-weekdays" aria-hidden="true">
            @foreach (var day in WeekdayLabels)
            {
                <span>@day</span>
            }
        </div>

        @if (isLoading)
        {
            <p class="strength-feedback" role="status">Indlæser kalender…</p>
        }
        else if (error is not null)
        {
            <section class="strength-status-card" role="alert">
                <p>@error</p>
                <button class="strength-secondary-button" type="button" @onclick="LoadAsync">Prøv igen</button>
            </section>
        }
        else
        {
            <div class="running-calendar-grid calendar-grid" @ref="calendarGrid" aria-labelledby="calendar-month-title">
                @foreach (var cell in calendarDays)
                {
                    if (cell.Date is { } calendarDate)
                    {
                        <button @key="calendarDate" class="@CellClass(calendarDate)" type="button" data-calendar-day
                                @ref="dayButtons[calendarDate]"
                                @onclick="() => SelectDateAsync(calendarDate)"
                                @onkeydown="args => HandleDayKeyDownAsync(args, calendarDate)"
                                aria-pressed="@(calendarDate == selectedDate)" aria-current="@(calendarDate == BrowserToday ? "date" : null)"
                                tabindex="@(FocusDate == calendarDate ? "0" : "-1")"
                                aria-label="@DayLabel(calendarDate)">
                            <span>@calendarDate.Day</span>
                            <span class="calendar-day-indicators" aria-hidden="true">
                                @foreach (var indicator in IndicatorsOn(calendarDate))
                                {
                                    <i class="@indicator"></i>
                                }
                            </span>
                        </button>
                    }
                    else
                    {
                        <span class="running-calendar-day" role="presentation" aria-hidden="true"></span>
                    }
                }
            </div>

            <section class="running-calendar-selected calendar-selected" aria-live="polite" aria-labelledby="selected-date-title">
                <div class="strength-section-row calendar-selected-heading">
                    <div>
                        <p class="strength-overline">Valgt dag</p>
                        <h2 id="selected-date-title">@RunningPresentation.Date(selectedDate)</h2>
                        <p class="calendar-activity-count">@ActivityCountText</p>
                    </div>
                    @if (CanRegisterRun)
                    {
                        <a class="strength-text-action" href="@ManualLogHref()">Registrer løb</a>
                    }
                </div>

                @if (ActivitiesOn(selectedDate).Count == 0 && RelationshipsOn(selectedDate).Count == 0)
                {
                    <div class="strength-empty-compact">
                        <p>Ingen aktiviteter på denne dag.</p>
                        @if (selectedDate > BrowserToday)
                        {
                            <p>Et manuelt løb kan først registreres med en faktisk dato i dag eller tidligere.</p>
                        }
                    </div>
                }
                else
                {
                    @if (ActivitiesOn(selectedDate).Count > 0)
                    {
                        <div class="calendar-activity-list">
                            @foreach (var activity in ActivitiesOn(selectedDate))
                            {
                                var href = ActivityHref(activity);
                                @if (href is not null)
                                {
                                    <a class="@ActivityClass(activity)" href="@href" @key="ActivityKey(activity)">
                                        <span class="calendar-activity-kind">@ActivityTypeText(activity)</span>
                                        <span class="calendar-activity-copy">
                                            <strong>@ActivityTitle(activity)</strong>
                                            <span>@ActivityDetail(activity)</span>
                                            <span class="@ActivityStatusClass(activity)">@ActivityStatusText(activity)</span>
                                        </span>
                                        <span class="running-session-chevron" aria-hidden="true">›</span>
                                    </a>
                                }
                                else
                                {
                                    <article class="@ActivityClass(activity)" @key="ActivityKey(activity)">
                                        <span class="calendar-activity-kind">@ActivityTypeText(activity)</span>
                                        <span class="calendar-activity-copy">
                                            <strong>@ActivityTitle(activity)</strong>
                                            <span>@ActivityDetail(activity)</span>
                                            <span class="@ActivityStatusClass(activity)">@ActivityStatusText(activity)</span>
                                        </span>
                                    </article>
                                }
                            }
                        </div>
                    }

                    @if (RelationshipsOn(selectedDate).Count > 0)
                    {
                        <section class="calendar-relationships" aria-label="Oprindeligt planlagte løb">
                            <p class="strength-overline">Oprindeligt planlagt</p>
                            @foreach (var completed in RelationshipsOn(selectedDate))
                            {
                                <a href="@ActivityHref(completed)" class="calendar-relationship-row" @key="ActivityKey(completed)">
                                    <span><strong>@ActivityTitle(completed)</strong><small>Gennemført @RunningPresentation.ShortDate(completed.Date)</small></span>
                                    <span class="running-session-chevron" aria-hidden="true">›</span>
                                </a>
                            }
                        </section>
                    }
                }
            </section>
        }
    </section>

    <StrengthBottomNavigation Active="calendar" />
</main>

@code {
    private static readonly string[] WeekdayLabels = ["Man", "Tir", "Ons", "Tor", "Fre", "Lør", "Søn"];
    private DateOnly month = MonthStart(BrowserToday);
    private DateOnly selectedDate = BrowserToday;
    private List<CalendarCell> calendarDays = [];
    private Dictionary<DateOnly, List<CalendarActivityResponse>> activitiesByDate = [];
    private Dictionary<DateOnly, List<CalendarActivityResponse>> relationshipsByDate = [];
    private readonly Dictionary<DateOnly, ElementReference> dayButtons = [];
    private ElementReference calendarGrid;
    private CancellationTokenSource? loadCancellation;
    private int loadRequestVersion;
    private bool hasRouteState;
    private bool isLoading;
    private string? error;
    private DateOnly? keyboardFocusDate;
    private DateOnly? pendingFocusDate;

    [SupplyParameterFromQuery(Name = "maaned")] public string? RequestedMonth { get; set; }
    [SupplyParameterFromQuery(Name = "dato")] public string? RequestedDate { get; set; }

    private bool CanRegisterRun => selectedDate >= EarliestResultDate && selectedDate <= BrowserToday;
    private bool IsShowingToday => month == MonthStart(BrowserToday) && selectedDate == BrowserToday;
    private DateOnly FocusDate => keyboardFocusDate is { } focused && MonthStart(focused) == month
        ? focused
        : selectedDate;
    private string ActivityCountText
    {
        get
        {
            var activities = ActivitiesOn(selectedDate).Count;
            var relationships = RelationshipsOn(selectedDate).Count;
            var actualText = activities switch
            {
                0 => "Ingen aktiviteter på denne dato",
                1 => "1 aktivitet på denne dato",
                _ => $"{activities} aktiviteter på denne dato"
            };
            return relationships == 0
                ? actualText
                : relationships == 1
                    ? $"{actualText} · 1 løb er gennemført på en anden dato"
                    : $"{actualText} · {relationships} løb er gennemført på andre datoer";
        }
    }

    protected override Task OnParametersSetAsync()
    {
        var nextMonth = MonthStart(BrowserToday);
        var nextSelectedDate = BrowserToday;
        if (CalendarRoute.TryParseState(RequestedMonth, RequestedDate, out var requestedMonth, out var requestedDate))
        {
            nextMonth = requestedMonth;
            nextSelectedDate = requestedDate;
        }

        if (hasRouteState && nextMonth == month && nextSelectedDate == selectedDate)
        {
            return Task.CompletedTask;
        }

        hasRouteState = true;
        month = nextMonth;
        selectedDate = nextSelectedDate;
        keyboardFocusDate = nextSelectedDate;
        BuildCalendarDays();
        return LoadAsync();
    }

    private Task PreviousMonthAsync() => ChangeMonthAsync(month.AddMonths(-1));

    private Task NextMonthAsync() => ChangeMonthAsync(month.AddMonths(1));

    private Task TodayAsync() => SetCalendarStateAsync(MonthStart(BrowserToday), BrowserToday,
        reload: month != MonthStart(BrowserToday));

    private Task SelectDateAsync(DateOnly date) => SetCalendarStateAsync(month, date, reload: false);

    private async Task ChangeMonthAsync(DateOnly nextMonth)
    {
        nextMonth = MonthStart(nextMonth);
        await SetCalendarStateAsync(nextMonth, new DateOnly(nextMonth.Year, nextMonth.Month, 1), reload: true);
    }

    private async Task SetCalendarStateAsync(DateOnly nextMonth, DateOnly nextSelectedDate, bool reload)
    {
        var rangeChanged = nextMonth != month;
        month = MonthStart(nextMonth);
        selectedDate = nextSelectedDate;
        keyboardFocusDate = nextSelectedDate;
        BuildCalendarDays();
        Navigation.NavigateTo(CalendarRoute.Path(month, selectedDate), replace: true);
        if (reload && rangeChanged)
        {
            await LoadAsync();
        }
    }

    private async Task HandleDayKeyDownAsync(KeyboardEventArgs args, DateOnly date)
    {
        var nextDate = args.Key switch
        {
            "ArrowLeft" => date.AddDays(-1),
            "ArrowRight" => date.AddDays(1),
            "ArrowUp" => date.AddDays(-7),
            "ArrowDown" => date.AddDays(7),
            "Home" => date.AddDays(-((int)date.DayOfWeek + 6) % 7),
            "End" => date.AddDays(6 - ((int)date.DayOfWeek + 6) % 7),
            _ => default
        };
        if (nextDate == default)
        {
            return;
        }

        var nextMonth = MonthStart(nextDate);
        keyboardFocusDate = nextDate;
        pendingFocusDate = nextDate;
        await SetCalendarStateAsync(nextMonth, nextDate, reload: nextMonth != month);
    }

    private async Task LoadAsync()
    {
        var requestedMonth = month;
        var requestVersion = ++loadRequestVersion;
        loadCancellation?.Cancel();
        loadCancellation?.Dispose();
        loadCancellation = new CancellationTokenSource();
        isLoading = true;
        error = null;
        var response = await Calendar.GetRangeAsync(requestedMonth, requestedMonth.AddMonths(1).AddDays(-1),
            loadCancellation.Token);
        if (requestVersion != loadRequestVersion || requestedMonth != month)
        {
            return;
        }

        if (response.Succeeded && response.Value is { } range)
        {
            var start = requestedMonth;
            var end = requestedMonth.AddMonths(1).AddDays(-1);
            activitiesByDate = range.Activities
                .Where(activity => activity.Date >= start && activity.Date <= end)
                .GroupBy(activity => activity.Date)
                .ToDictionary(group => group.Key, group => group.ToList());
            relationshipsByDate = range.Activities
                .Where(activity => activity.PlannedDate is { } plannedDate && plannedDate != activity.Date &&
                                   plannedDate >= start && plannedDate <= end)
                .GroupBy(activity => activity.PlannedDate!.Value)
                .ToDictionary(group => group.Key, group => group.ToList());
        }
        else if (!response.IsCanceled)
        {
            activitiesByDate = [];
            relationshipsByDate = [];
            error = response.Error ?? "Kalenderen kunne ikke indlæses. Prøv igen.";
        }

        isLoading = false;
    }

    private void BuildCalendarDays()
    {
        var leading = ((int)month.DayOfWeek + 6) % 7;
        var daysInMonth = DateTime.DaysInMonth(month.Year, month.Month);
        calendarDays = [];
        dayButtons.Clear();
        for (var index = 0; index < leading; index++)
        {
            calendarDays.Add(new CalendarCell(null));
        }

        for (var day = 1; day <= daysInMonth; day++)
        {
            calendarDays.Add(new CalendarCell(new DateOnly(month.Year, month.Month, day)));
        }

        while (calendarDays.Count % 7 != 0)
        {
            calendarDays.Add(new CalendarCell(null));
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (isLoading || error is not null)
        {
            return;
        }

        await JavaScript.InvokeVoidAsync("fitnessCalendar.bindKeyboardNavigation", calendarGrid);
        if (pendingFocusDate is not { } focusDate || !dayButtons.TryGetValue(focusDate, out var element))
        {
            return;
        }

        pendingFocusDate = null;
        await JavaScript.InvokeVoidAsync("fitnessCalendar.focus", element);
    }

    private IReadOnlyList<CalendarActivityResponse> ActivitiesOn(DateOnly date) => activitiesByDate.GetValueOrDefault(date) ?? [];

    private IReadOnlyList<CalendarActivityResponse> RelationshipsOn(DateOnly date) => relationshipsByDate.GetValueOrDefault(date) ?? [];

    private IReadOnlyList<string> IndicatorsOn(DateOnly date)
    {
        var indicators = new List<string>();
        if (ActivitiesOn(date).Any(activity => activity.Type == CalendarActivityType.Running && activity.State == CalendarActivityState.Completed))
        {
            indicators.Add("calendar-day-indicator is-running is-completed");
        }
        else if (ActivitiesOn(date).Any(activity => activity.Type == CalendarActivityType.Running && activity.State == CalendarActivityState.Started))
        {
            indicators.Add("calendar-day-indicator is-running is-started");
        }
        else if (ActivitiesOn(date).Any(activity => activity.Type == CalendarActivityType.Running))
        {
            indicators.Add("calendar-day-indicator is-running");
        }

        if (ActivitiesOn(date).Any(activity => activity.Type == CalendarActivityType.Strength && activity.State == CalendarActivityState.Completed))
        {
            indicators.Add("calendar-day-indicator is-strength is-completed");
        }
        else if (ActivitiesOn(date).Any(activity => activity.Type == CalendarActivityType.Strength))
        {
            indicators.Add("calendar-day-indicator is-strength");
        }

        if (RelationshipsOn(date).Count > 0)
        {
            indicators.Add("calendar-day-indicator is-related");
        }

        return indicators;
    }

    private string CellClass(DateOnly date) => $"running-calendar-day is-current-month{(date == BrowserToday ? " is-today" : "")}{(date == selectedDate ? " is-selected" : "")}";

    private string DayLabel(DateOnly date)
    {
        var activities = ActivitiesOn(date).Count;
        var relationships = RelationshipsOn(date).Count;
        var description = activities switch
        {
            0 => "ingen aktiviteter",
            1 => "1 aktivitet",
            _ => $"{activities} aktiviteter"
        };
        if (relationships > 0)
        {
            description += relationships == 1
                ? "; 1 løb er gennemført på en anden dag"
                : $"; {relationships} løb er gennemført på andre dage";
        }

        return $"{RunningPresentation.Date(date)}: {description}";
    }

    private string? ActivityHref(CalendarActivityResponse activity)
    {
        if (activity.RunningResultId is { } resultId)
        {
            return CalendarRoute.AppendState($"/loeb/resultater/{resultId}", month, selectedDate);
        }

        if (activity.RunningSessionId is { } sessionId)
        {
            return CalendarRoute.AppendState($"/loeb/plan/{sessionId}", month, selectedDate);
        }

        if (activity.StrengthCompletionId is { } completionId)
        {
            return CalendarRoute.AppendState($"/styrke/resultater/{completionId}", month, selectedDate);
        }

        if (activity.StrengthProgramId is { } programId && activity.StrengthWorkoutId is { } workoutId)
        {
            return CalendarRoute.AppendState($"/styrke/{programId}/træninger/{workoutId}/aktiv", month, selectedDate);
        }

        return null;
    }

    private string ManualLogHref() => CalendarRoute.ManualRunningPath(month, selectedDate);

    private static string ActivityKey(CalendarActivityResponse activity) =>
        $"{activity.Date:yyyy-MM-dd}-{activity.Type}-{activity.State}-{activity.Id}";

    private static string ActivityTypeText(CalendarActivityResponse activity) => activity.Type == CalendarActivityType.Running ? "Løb" : "Styrke";

    private static string ActivityTitle(CalendarActivityResponse activity) => activity.Type switch
    {
        CalendarActivityType.Running when activity.RunningKind is { } kind => KindName(kind),
        CalendarActivityType.Running => "Manuelt løb",
        _ => activity.Title
    };

    private static string ActivityDetail(CalendarActivityResponse activity)
    {
        if (activity.Type == CalendarActivityType.Strength)
        {
            return activity.State == CalendarActivityState.Completed ? "Gennemført styrketræning" : "Planlagt styrketræning";
        }

        if (activity.State != CalendarActivityState.Completed)
        {
            return RunningPresentation.Distance(activity.PlannedDistanceKm);
        }

        var values = new List<string>();
        if (activity.ActualDistanceKm is not null)
        {
            values.Add(RunningPresentation.Distance(activity.ActualDistanceKm));
        }
        if (activity.ActualDurationSeconds is not null)
        {
            values.Add(RunningPresentation.Duration(activity.ActualDurationSeconds));
        }
        if (activity.PlannedDate is { } plannedDate && plannedDate != activity.Date)
        {
            values.Add($"Planlagt {RunningPresentation.ShortDate(plannedDate)}");
        }

        return values.Count == 0 ? "Gennemført uden målinger" : string.Join(" · ", values);
    }

    private static string ActivityClass(CalendarActivityResponse activity) =>
        $"calendar-activity-row is-{(activity.Type == CalendarActivityType.Running ? "running" : "strength")} is-{activity.State.ToString().ToLowerInvariant()}";

    private static string ActivityStatusClass(CalendarActivityResponse activity) =>
        $"calendar-activity-status is-{activity.State.ToString().ToLowerInvariant()}";

    private static string ActivityStatusText(CalendarActivityResponse activity) => activity.State switch
    {
        CalendarActivityState.Completed => "Gennemført",
        CalendarActivityState.Started => "I gang",
        _ => "Planlagt"
    };

    private static string KindName(RunningSessionKind kind) => kind switch
    {
        RunningSessionKind.Easy => "Rolig tur",
        RunningSessionKind.Tempo => "Tempotur",
        RunningSessionKind.Intervals => "Intervaller",
        _ => "Lang tur"
    };

    private static DateOnly MonthStart(DateOnly value) => new(value.Year, value.Month, 1);
    private static DateOnly BrowserToday => RunningPresentation.CopenhagenToday;
    private static DateOnly EarliestResultDate => new(2000, 1, 1);

    public void Dispose()
    {
        loadCancellation?.Cancel();
        loadCancellation?.Dispose();
    }

    private sealed record CalendarCell(DateOnly? Date);
}
