@page "/styrke/{Id:guid}"
@attribute [Authorize]
@using FitnessApp.Contracts.Strength
@using FitnessApp.Client.Strength
@inject StrengthProgramClient Programs
@inject NavigationManager Navigation

<PageTitle>@(program?.Name ?? "Program")</PageTitle>
<main class="strength-page" aria-labelledby="program-title">
    <a class="back-link" href="/styrke">Tilbage til programmer</a>
    <header class="strength-header"><h1 id="program-title">@(program?.Name ?? "Program")</h1></header>
    @if (loading) { <p role="status">Indlæser program…</p> }
    @if (error is not null)
    {
        <p class="notice notice-error" role="alert">@error</p>
        @if (!missing) { <button class="button button-secondary" disabled="@busy" @onclick="LoadAsync">@(conflict ? "Genindlæs program" : "Prøv igen")</button> }
    }
    @if (program is not null && !loading)
    {
        <p class="status-message">@program.Exercises.Count øvelser</p>
        <ol class="exercise-list">
            @foreach (var exercise in program.Exercises)
            {
                <li class="program-card exercise-detail"><div><h2>@exercise.Name</h2><p>@exercise.Sets sæt × @exercise.Repetitions gentagelser</p><span class="warmup-label">@(exercise.IsWarmUp ? "Opvarmning" : "Uden opvarmning")</span></div></li>
            }
        </ol>
        @if (confirmDelete)
        {
            <section class="notice notice-warning" aria-labelledby="delete-title">
                <h2 id="delete-title">Slet @program.Name?</h2><p>Programmet og alle dets øvelser slettes. Det kan ikke fortrydes.</p>
                <div class="decision-actions"><button class="button button-secondary" disabled="@busy" @onclick="() => confirmDelete = false">Annuller</button><button class="button button-danger" disabled="@busy" @onclick="DeleteAsync">@(busy ? "Sletter…" : "Slet program")</button></div>
            </section>
        }
        else
        {
            <div class="decision-actions strength-actions"><a class="button button-primary button-link" href="@($"/styrke/{Id}/rediger")">Rediger program</a><button class="button button-danger-outline" @onclick="() => confirmDelete = true">Slet program</button></div>
        }
    }
</main>
@code {
    [Parameter] public Guid Id { get; set; }
    private ProgramResponse? program;
    private bool loading, busy, confirmDelete, conflict, missing;
    private string? error;
    protected override Task OnParametersSetAsync() => LoadAsync();
    private async Task LoadAsync()
    {
        if (loading || busy) return;
        loading = true;
        var result = await Programs.GetAsync(Id);
        program = result.Value;
        error = result.Error;
        missing = result.NotFound;
        conflict = false;
        confirmDelete = false;
        loading = false;
    }
    private async Task DeleteAsync()
    {
        if (busy || program is null) return;
        busy = true;
        var result = await Programs.DeleteAsync(Id, program.Version);
        busy = false;
        if (result.Succeeded || result.NotFound) Navigation.NavigateTo("/styrke");
        else { error = result.Error; conflict = result.Conflict; confirmDelete = false; }
    }
}
