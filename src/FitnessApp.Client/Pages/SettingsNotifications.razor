@page "/indstillinger/notifikationer"
@attribute [Authorize]
@using FitnessApp.Client.Settings
@using FitnessApp.Contracts.Settings
@using FitnessApp.Contracts.Notifications
@inject SettingsClient SettingsApi
@inject NotificationClient Notifications
@inject IJSRuntime JS

<PageTitle>Notifikationer</PageTitle>
<main class="strength-app settings-app strength-with-bottom-nav" aria-labelledby="notifications-title">
    <header class="strength-back-header settings-page-header">
        <a class="strength-icon-button" href="/indstillinger" aria-label="Tilbage til indstillinger">←</a>
        <div><p class="strength-overline">App</p><h1 id="notifications-title">Notifikationer</h1></div>
        <NotificationBell />
    </header>
    <div class="settings-page-content">
        @if (loading) { <p role="status">Indlæser indstillinger…</p> }
        @if (error is not null) { <p class="strength-field-error" role="alert">@error</p><button class="strength-secondary-button" @onclick="LoadAsync" disabled="@busy">Prøv igen</button> }
        @if (preferences is { } p)
        {
            <p>Vælg beskeder til indbakken og telefonen. Klokken øverst åbner indbakken. Tidspunkterne følger din tidszone; levering kan blive forsinket af telefonen.</p>
            <section class="settings-section" aria-label="Notifikationskategorier">
                <div class="settings-toggle-list">
                    @foreach (var row in Rows(p))
                    {
                        <label class="settings-toggle-row">
                            <span class="settings-toggle-copy"><strong>@row.Title</strong><span>@row.Description</span></span>
                            <span class="settings-switch"><input type="checkbox" checked="@row.Enabled" disabled="@busy" @onchange="e => SaveToggleAsync(row.Key, e)" /><span aria-hidden="true"></span></span>
                        </label>
                    }

                </div>
                <label for="notification-timezone">Tidszone</label>
                <input id="notification-timezone" class="notification-timezone" @bind="timeZone" list="notification-timezones" disabled="@busy" />
                <datalist id="notification-timezones"><option value="Europe/Copenhagen" /><option value="Europe/London" /><option value="America/New_York" /></datalist>
                <button class="strength-secondary-button" disabled="@busy" @onclick="SaveZoneAsync">Gem tidszone</button>
                <p>Standard: Europe/Copenhagen. Sommer- og vintertid følger tidszonen.</p>
            </section>
            <section class="settings-section" aria-labelledby="phone-title">
                <h2 id="phone-title">Telefonnotifikationer på denne enhed</h2>
                <button class="strength-text-action" @onclick="RefreshDeviceAsync" disabled="@busy">Opdater telefonstatus</button>
                <p>Indbakken virker også med telefonnotifikationer slået fra. Dine tidligere beskeder bevares.</p>
                @if (browser is null) { <p role="status">Kontrollerer browseren…</p> }
                else
                {
                    <p role="status">@PhoneStatus</p>
                    @if (device is { Configured: false }) { <p>Telefonnotifikationer er ikke konfigureret på serveren endnu.</p> }
                    <button class="strength-secondary-button" @onclick="EnableAsync" disabled="@(busy || device is not { Configured: true } || !browser.Supported || browser.Permission == "denied" || browser.Ios && !browser.Installed)">Slå til på denne enhed</button>
                    <button class="strength-secondary-button" @onclick="DisableAsync" disabled="@(busy || browser.InstallationId is null || browser.Binding is null && device is { HasRegistration: false })">Slå fra på denne enhed</button>
                    <button class="strength-secondary-button" @onclick="TestAsync" disabled="@(busy || device is not { Subscribed: true })">Send testnotifikation</button>
                    <p>Højst én test pr. fem minutter. En test i indbakken er ikke en bekræftelse på telefonens levering.</p>
                }
                <label class="settings-toggle-row">
                    <span class="settings-toggle-copy"><strong>Vis detaljer på låseskærmen</strong><span>Slået fra som standard. Vis ellers kort trænings- eller kostinformation. Hele kostoversigten findes altid i den beskyttede indbakke.</span></span>
                    <span class="settings-switch"><input type="checkbox" checked="@p.DetailedPushPreviews" disabled="@busy" @onchange="SavePreviewAsync" /><span aria-hidden="true"></span></span>
                </label>
                <p>På iPhone: Åbn i Safari, tryk Del → Føj til hjemmeskærm. Åbn derefter FitnessApp fra hjemmeskærmen og slå telefonnotifikationer til her (iOS 16.4 eller nyere).</p>
                <p>På Android eller computer kan du installere appen via browserens menu. Internet, tilladelse og en tilgængelig server er nødvendige. Fokus, batterisparefunktioner og operativsystemet kan forsinke eller blokere levering.</p>
                <p>Ved logout eller nyt login slås denne enheds tilmelding fra. Tilmeld igen efter login. En lukket app stopper ikke tilmeldingen.</p>
            </section>
        }
        @if (actionError is not null) { <p class="strength-field-error" role="alert">@actionError</p> }
        @if (message is not null) { <p role="status">@message</p> }
    </div>
    <StrengthBottomNavigation Active="settings" />
</main>

@code {
    private NotificationPreferencesResponse? preferences;
    private BrowserPushState? browser;
    private PushDeviceResponse? device;
    private bool loading = true, busy;
    private string timeZone = "Europe/Copenhagen";
    private string? error, actionError, message;
    protected override Task OnInitializedAsync() => LoadAsync();
    protected override async Task OnAfterRenderAsync(bool firstRender) { if (firstRender) { await RefreshDeviceAsync(); StateHasChanged(); } }
    private async Task LoadAsync()
    {
        loading = true; error = null;
        var result = await SettingsApi.GetOverviewAsync();
        if (result.Succeeded && result.Value is { } value) { preferences = value.NotificationPreferences; timeZone = preferences.TimeZoneId; }
        else error = result.Error;
        loading = false;
    }
    private static (string Key, string Title, string Description, bool Enabled)[] Rows(NotificationPreferencesResponse p) => [
        ("run", "Løb", "Dagens planlagte løb kl. 07.00.", p.RunningNotificationsEnabled),
        ("strength", "Styrketræning", "Dagens planlagte styrketræning kl. 07.00.", p.StrengthNotificationsEnabled),
        ("meal", "Måltidspåmindelser", "Morgenmad kl. 10.00, frokost kl. 14.00 og aftensmad kl. 19.30, hvis måltidet er tomt.", p.MealRemindersEnabled),
        ("progress", "Kostoversigt", "Kl. 10.00, 14.00 og 19.30, når måltidet er registreret, og der er tilføjet ny mad siden sidste oversigt.", p.NutritionProgressEnabled),
        ("diary", "Dagbog", "Kl. 20.00, hvis du endnu ikke har gemt tekst i dagens dagbog.", p.DiaryRemindersEnabled) ];
    private Task SaveToggleAsync(string key, ChangeEventArgs args)
    {
        if (preferences is null) return Task.CompletedTask;
        var enabled = args.Value is true;
        var next = key switch {
            "run" => preferences with { RunningNotificationsEnabled = enabled }, "strength" => preferences with { StrengthNotificationsEnabled = enabled },
            "meal" => preferences with { MealRemindersEnabled = enabled }, "progress" => preferences with { NutritionProgressEnabled = enabled },
            "diary" => preferences with { DiaryRemindersEnabled = enabled },
            _ => preferences with { DetailedPushPreviews = enabled } };
        return SaveAsync(next);
    }
    private Task SavePreviewAsync(ChangeEventArgs args) => SaveToggleAsync("preview", args);
    private Task SaveZoneAsync() => preferences is null ? Task.CompletedTask : SaveAsync(preferences with { TimeZoneId = timeZone.Trim() });
    private async Task SaveAsync(NotificationPreferencesResponse next)
    {
        if (busy) return;
        busy = true; actionError = null; message = null;
        var result = await SettingsApi.UpdateNotificationPreferencesAsync(new(next.RunningNotificationsEnabled, next.StrengthNotificationsEnabled,
            next.MealRemindersEnabled, next.NutritionProgressEnabled, next.DetailedPushPreviews, next.TimeZoneId, next.DiaryRemindersEnabled));
        if (result.Succeeded && result.Value is { } saved)
        {
            preferences = saved; timeZone = saved.TimeZoneId; message = "Indstillingerne er gemt.";
            try { await JS.InvokeVoidAsync("fitnessPush.previews", saved.DetailedPushPreviews); }
            catch (JSException) { actionError = "Telefonens forhåndsvisning kunne ikke opdateres. Slå telefonnotifikationer fra og til igen."; }
        }
        else actionError = result.Error;
        busy = false;
    }
    private async Task RefreshDeviceAsync()
    {
        try
        {
            browser = await JS.InvokeAsync<BrowserPushState>("fitnessPush.status");
            var result = await Notifications.DeviceAsync(browser.Binding, browser.InstallationId);
            device = result.Value;
            if (!result.Succeeded) actionError = result.Error;
        }
        catch (JSException) { actionError = "Telefonstatus kunne ikke indlæses. Genindlæs siden og prøv igen."; }
    }
    private async Task EnableAsync()
    {
        if (busy || device?.PublicKey is not { } key) return;
        busy = true; actionError = null; message = null;
        try
        {
            // Permission is requested by this explicit click, before any network request.
            var subscription = await JS.InvokeAsync<SubscribePushRequest>("fitnessPush.enable", key, preferences?.DetailedPushPreviews == true);
            var result = await Notifications.SubscribeAsync(subscription);
            if (!result.Succeeded) { await JS.InvokeVoidAsync("fitnessPush.clear"); actionError = result.Error; }
            else message = "Telefonnotifikationer er slået til på denne enhed.";
        }
        catch (JSException) { actionError = "Tilmelding blev ikke gennemført. Kontrollér tilladelsen og hjemmeskærmsinstallationen, og prøv igen."; }
        await RefreshDeviceAsync(); busy = false;
    }
    private async Task DisableAsync()
    {
        if (busy) return;
        busy = true; actionError = null; message = null;
        var installationId = browser?.InstallationId;
        try
        {
            await JS.InvokeVoidAsync("fitnessPush.clear");
            if (installationId is not null)
            {
                var result = await Notifications.UnsubscribeAsync(installationId);
                if (result.Succeeded) message = "Telefonnotifikationer er slået fra på denne enhed.";
                else actionError = "Forhåndsvisninger er fjernet lokalt, men serverens tilmelding kunne ikke fjernes. Tryk Slå fra på denne enhed igen for at prøve igen.";
            }
        }
        catch (JSException) { actionError = "Enhedens tilmelding kunne ikke fjernes. Prøv igen."; }
        await RefreshDeviceAsync(); busy = false;
    }
    private async Task TestAsync()
    {
        if (busy || browser?.Binding is not { } binding) return;
        busy = true; actionError = null; message = null;
        var result = await Notifications.TestAsync(binding);
        if (result.Succeeded) message = "Testen er sat i kø. Kontrollér telefonens notifikationer.";
        else actionError = result.Error;
        busy = false;
    }
    private string PhoneStatus => browser is null ? "" : !browser.Supported ? "Denne browser understøtter ikke telefonnotifikationer." :
        browser.Ios && !browser.Installed ? "Installer først FitnessApp på hjemmeskærmen." :
        browser.Permission == "denied" ? "Tilladelsen er blokeret. Åbn telefonens eller browserens indstillinger for at ændre den." :
        device?.Subscribed == true && browser.Subscribed ? "Tilladelse givet · denne enhed er tilmeldt." :
        device?.HasRegistration == true ? "Enheden har stadig en servertilmelding. Slå fra for at fjerne den, eller tilmeld igen." :
        browser.Permission == "granted" ? "Tilladelse givet · denne enhed er ikke tilmeldt denne session." : "Tilladelse er ikke givet endnu.";
    private sealed record BrowserPushState(bool Supported, bool Ios, bool Installed, string Permission, bool Subscribed, string? Binding, string? InstallationId);
}
