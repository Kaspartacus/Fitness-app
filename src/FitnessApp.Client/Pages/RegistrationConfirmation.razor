@page "/registrering-modtaget"

<PageTitle>Registrering modtaget</PageTitle>

<main class="auth-page" aria-labelledby="confirmation-title">
    <section class="auth-panel confirmation-panel">
        <div class="brand-mark brand-mark-success" aria-hidden="true">✓</div>
        <header class="auth-heading">
            <h1 id="confirmation-title">Tak for din registrering</h1>
            <p>Din anmodning er sendt til en administrator.</p>
        </header>
        <p class="confirmation-copy">Du kan logge ind, når kontoen er blevet godkendt. Der sendes ikke en e-mail fra appen.</p>
        <a class="button button-primary button-link" href="/login">Tilbage til login</a>
    </section>
</main>
