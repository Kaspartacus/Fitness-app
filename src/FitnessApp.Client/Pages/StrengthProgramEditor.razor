@page "/styrke/opret"
@page "/styrke/{Id:guid}/rediger"
@attribute [Authorize]
@using FitnessApp.Contracts.Strength
@using FitnessApp.Client.Strength
@inject StrengthProgramClient Programs
@inject NavigationManager Navigation

<PageTitle>@(Id is null ? "Nyt program" : "Rediger program")</PageTitle>

<NavigationLock OnBeforeInternalNavigation="ConfirmNavigationAsync" />

<main class="strength-app strength-form-page" aria-labelledby="editor-title">
    <header class="strength-back-header">
        <button class="strength-icon-button" type="button" @onclick="TryNavigateBack" disabled="@busy" aria-label="@BackLabel" title="@BackLabel">←</button>
        <h1 id="editor-title">@(Id is null ? "Nyt program" : "Rediger program")</h1>
        <span class="strength-header-spacer"></span>
    </header>

    @if (loading)
    {
        <p class="strength-feedback" role="status">Indlæser program…</p>
    }
    else if (loadError is not null)
    {
        <section class="strength-status-card" role="alert"><p>@loadError</p><button class="strength-secondary-button" type="button" @onclick="LoadAsync">Prøv igen</button></section>
    }
    else
    {
        <form class="strength-editor-card" @onsubmit="SaveAsync" @onsubmit:preventDefault>
            <p class="strength-overline">Program</p>
            <h2>@(Id is null ? "Giv dit program et navn" : "Opdatér programnavnet")</h2>
            <p>Du kan derefter tilføje træninger og øvelser.</p>
            <label class="strength-input-label" for="program-name">Navn på program</label>
            <input class="strength-input" id="program-name" maxlength="100" required value="@draft.Name" @oninput="OnNameChanged" disabled="@busy" placeholder="For eksempel 4-dages split" />
            @if (validationError is not null)
            {
                <p class="strength-field-error" role="alert">@validationError</p>
            }
            @if (saveError is not null)
            {
                <p class="strength-field-error" role="alert">@saveError</p>
                @if (saveConflict)
                {
                    <button class="strength-secondary-button" type="button" @onclick="LoadAsync" disabled="@busy">Genindlæs program</button>
                }
            }
            <div class="strength-form-actions">
                <button class="strength-outline-button" type="button" @onclick="TryNavigateBack" disabled="@busy">Annuller</button>
                <button class="strength-primary-button" type="submit" disabled="@busy">@(busy ? "Gemmer…" : Id is null ? "Opret program" : "Gem ændringer")</button>
            </div>
        </form>
    }
    <ModalDialog IsOpen="@discardChangesOpen" Title="Forlad uden at gemme?" Description="Dine ændringer bliver ikke gemt."
                 InitialFocusSelector="[data-modal-cancel]" Destructive="true" OnDismiss="CloseDiscardChanges">
        <div class="app-modal-actions">
            <button class="strength-quiet-button" type="button" data-modal-cancel @onclick="CloseDiscardChanges">Bliv på siden</button>
            <button class="strength-danger-button" type="button" @onclick="DiscardChangesAndNavigate">Forlad uden at gemme</button>
        </div>
    </ModalDialog>
</main>

@code {
    [Parameter] public Guid? Id { get; set; }

    private SaveProgramRequest draft = new() { Workouts = [] };
    private bool loading;
    private bool busy;
    private bool hasParameters;
    private bool isDirty;
    private bool discardChangesOpen;
    private Guid? loadedId;
    private string? pendingNavigationUrl;
    private string? loadError;
    private string? saveError;
    private string? validationError;
    private bool saveConflict;

    private string BackUrl => Id is null ? "/styrke" : $"/styrke/{Id}";
    private string BackLabel => Id is null ? "Tilbage til styrketræning" : "Tilbage til program";

    protected override Task OnParametersSetAsync()
    {
        if (hasParameters && loadedId == Id)
        {
            return Task.CompletedTask;
        }

        hasParameters = true;
        loadedId = Id;
        return LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (loading || busy)
        {
            return;
        }

        loadError = null;
        saveError = null;
        saveConflict = false;
        validationError = null;
        if (Id is null)
        {
            draft = new SaveProgramRequest { Workouts = [] };
            isDirty = false;
            return;
        }

        loading = true;
        var result = await Programs.GetAsync(Id.Value);
        loading = false;
        loadError = result.Error;
        if (result.Value is { } program)
        {
            draft = new SaveProgramRequest
            {
                Name = program.Name,
                Version = program.Version,
                Workouts = program.Workouts.Select(Copy).ToList()
            };
            isDirty = false;
        }
    }

    private void OnNameChanged(ChangeEventArgs change)
    {
        if (busy)
        {
            return;
        }

        draft.Name = change.Value?.ToString() ?? string.Empty;
        isDirty = true;
        validationError = null;
        saveError = null;
        saveConflict = false;
    }

    private async Task SaveAsync()
    {
        if (busy)
        {
            return;
        }

        validationError = string.IsNullOrWhiteSpace(draft.Name) ? "Skriv et navn på programmet." : null;
        if (validationError is not null)
        {
            return;
        }

        saveError = null;
        saveConflict = false;
        busy = true;
        var request = new SaveProgramRequest
        {
            Name = draft.Name,
            Version = draft.Version,
            Workouts = draft.Workouts?.Select(Copy).ToList()
        };
        var result = await Programs.SaveAsync(Id, request);
        busy = false;
        if (result.Value is { } program)
        {
            isDirty = false;
            Navigation.NavigateTo($"/styrke/{program.Id}");
            return;
        }

        saveError = result.Error;
        saveConflict = result.Conflict;
    }

    private void TryNavigateBack() => RequestNavigation(BackUrl);

    private Task ConfirmNavigationAsync(LocationChangingContext context)
    {
        if (isDirty)
        {
            context.PreventNavigation();
            RequestNavigation(context.TargetLocation);
        }

        return Task.CompletedTask;
    }

    private void RequestNavigation(string url)
    {
        if (busy)
        {
            return;
        }

        if (!isDirty)
        {
            Navigation.NavigateTo(url);
            return;
        }

        pendingNavigationUrl = url;
        discardChangesOpen = true;
    }

    private void CloseDiscardChanges()
    {
        discardChangesOpen = false;
        pendingNavigationUrl = null;
    }

    private void DiscardChangesAndNavigate()
    {
        var url = pendingNavigationUrl ?? BackUrl;
        discardChangesOpen = false;
        pendingNavigationUrl = null;
        isDirty = false;
        Navigation.NavigateTo(url);
    }

    private static WorkoutRequest Copy(WorkoutResponse workout) => new()
    {
        Id = workout.Id,
        Name = workout.Name,
        Exercises = workout.Exercises.Select(exercise => new ExerciseRequest
        {
            Id = exercise.Id, Name = exercise.Name, Weight = exercise.Weight, Sets = exercise.Sets,
            Repetitions = exercise.Repetitions, Note = exercise.Note
        }).ToList()
    };

    private static WorkoutRequest Copy(WorkoutRequest workout) => new()
    {
        Id = workout.Id,
        Name = workout.Name,
        Exercises = workout.Exercises?.Select(Copy).ToList()
    };

    private static ExerciseRequest Copy(ExerciseRequest exercise) => new()
    {
        Id = exercise.Id,
        Name = exercise.Name,
        Weight = exercise.Weight,
        Sets = exercise.Sets,
        Repetitions = exercise.Repetitions,
        Note = exercise.Note
    };
}
