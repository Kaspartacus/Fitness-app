@page "/styrke"
@attribute [Authorize]
@using FitnessApp.Contracts.Strength
@using FitnessApp.Client.Strength
@inject StrengthProgramClient Programs

<PageTitle>Styrketræning</PageTitle>
<main class="strength-page" aria-labelledby="strength-title">
    <a class="back-link" href="/">Tilbage til hjem</a>
    <header class="strength-header"><h1 id="strength-title">Styrketræning</h1></header>
    <div class="strength-toolbar"><h2 class="overline">Mine programmer</h2><a class="button button-primary button-link" href="/styrke/opret">Opret program</a></div>
    @if (loading)
    {
        <p role="status">Indlæser programmer…</p>
    }
    else if (error is not null)
    {
        <p class="notice notice-error" role="alert">@error</p>
        <button class="button button-secondary" @onclick="LoadAsync">Prøv igen</button>
    }
    else if (programs.Count == 0)
    {
        <section class="state-panel compact-state empty-state"><h2>Dit første program</h2><p>Opret et program, og saml dine øvelser ét sted.</p></section>
    }
    else
    {
        <div class="program-list">
            @foreach (var program in programs)
            {
                <article class="program-card">
                    <div class="program-copy"><h2>@program.Name</h2><p>@program.Exercises.Count øvelser · @Summary(program)</p></div>
                    <a class="program-card-action" href="@($"/styrke/{program.Id}")" aria-label="@($"Se program: {program.Name}")">Se program</a>
                </article>
            }
        </div>
    }
</main>
@code {
    private List<ProgramResponse> programs = [];
    private bool loading;
    private string? error;
    protected override Task OnInitializedAsync() => LoadAsync();
    private async Task LoadAsync()
    {
        if (loading) return;
        loading = true;
        var result = await Programs.ListAsync();
        error = result.Error;
        programs = result.Value ?? [];
        loading = false;
    }
    private static string Summary(ProgramResponse program) => string.Join(" · ", program.Exercises.Take(3).Select(e => e.Name)) + (program.Exercises.Count > 3 ? " …" : "");
}
