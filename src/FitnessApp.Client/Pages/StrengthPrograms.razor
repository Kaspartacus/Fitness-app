@page "/styrke"
@attribute [Authorize]
@using FitnessApp.Contracts.Strength
@using FitnessApp.Client.Strength
@inject StrengthProgramClient Programs

<PageTitle>Styrketræning</PageTitle>

<main class="strength-app strength-with-bottom-nav" aria-labelledby="strength-title">
    <header class="strength-mobile-header">
        <div>
            <h1 id="strength-title">Styrketræning</h1>
        </div>
        <a class="strength-profile-button" href="/" aria-label="Tilbage til hjem" title="Tilbage til hjem">⌂</a>
    </header>

    @if (loading)
    {
        <p class="strength-feedback" role="status">Indlæser styrketræning…</p>
    }
    else if (error is not null)
    {
        <section class="strength-status-card" role="alert">
            <p>@error</p>
            <button class="strength-secondary-button" @onclick="LoadAsync">Prøv igen</button>
        </section>
    }
    else if (overview is not null)
    {
        <section class="strength-section" aria-labelledby="today-heading">
            <p class="strength-overline" id="today-heading">Dagens træning</p>
            @if (overview.Today is { } today)
            {
                <article class="strength-today-card">
                    <div class="strength-card-heading">
                        <div>
                            <h2>@today.WorkoutName</h2>
                            <p>@today.Exercises.Count øvelser</p>
                        </div>
                        <span class="strength-today-badge">I dag</span>
                    </div>
                    <a class="strength-primary-button strength-card-button" href="@ActiveUrl(today)">Start træning</a>
                </article>
            }
            else
            {
                <article class="strength-empty-compact">
                    <p>Ingen træning planlagt i dag.</p>
                    @if (overview.Programs.FirstOrDefault() is { } program)
                    {
                        <a href="@($"/styrke/{program.Id}/plan")">Planlæg din uge</a>
                    }
                </article>
            }
        </section>

        <section class="strength-section" aria-labelledby="programs-heading">
            <div class="strength-section-row strength-programs-heading">
                <p class="strength-overline" id="programs-heading">Mine programmer</p>
                <a class="strength-small-button" href="/styrke/opret">＋ Nyt program</a>
            </div>

            @if (overview.Programs.Count == 0)
            {
                <article class="strength-empty-state">
                    <span class="strength-empty-icon">＋</span>
                    <h2>Ingen programmer endnu</h2>
                    <p>Opret et program, og byg det med dine træninger og øvelser.</p>
                    <a class="strength-outline-button" href="/styrke/opret">Opret program</a>
                </article>
            }
            else
            {
                <div class="strength-program-grid">
                    @foreach (var program in overview.Programs)
                    {
                        <article class="strength-program-card">
                            <div class="strength-program-copy">
                                <h2>@program.Name</h2>
                                <p>@program.Workouts.Count træninger · @WorkoutSummary(program)</p>
                            </div>
                            <div class="strength-split-actions">
                                <a href="@($"/styrke/{program.Id}")">Se program</a>
                                <a class="strength-primary-split" href="@($"/styrke/{program.Id}/plan")">Planlæg</a>
                            </div>
                        </article>
                    }
                </div>
            }
        </section>
    }

    <StrengthBottomNavigation />
</main>

@code {
    private StrengthOverviewResponse? overview;
    private bool loading;
    private string? error;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        if (loading)
        {
            return;
        }

        loading = true;
        var result = await Programs.GetOverviewAsync();
        overview = result.Value;
        error = result.Error;
        loading = false;
    }

    private static string WorkoutSummary(ProgramResponse program) =>
        string.Join(" · ", program.Workouts.Take(4).Select(workout => workout.Name));

    private static string ActiveUrl(PlannedWorkoutResponse workout) =>
        $"/styrke/{workout.ProgramId}/træninger/{workout.WorkoutId}/aktiv";
}
