@page "/registrer"
@inject RegistrationClient Registration
@inject NavigationManager Navigation

<PageTitle>Opret bruger</PageTitle>

<main class="auth-page" aria-labelledby="register-title">
    <section class="auth-panel auth-panel-long">
        <a class="back-link" href="/login" aria-label="Tilbage til login">← Tilbage</a>
        <BrandMark />
        <header class="auth-heading">
            <h1 id="register-title">Opret bruger</h1>
            <p>Din konto skal godkendes, før du kan logge ind.</p>
        </header>

        <EditForm Model="model" OnValidSubmit="RegisterAsync" FormName="registration" class="auth-form">
            <DataAnnotationsValidator />

            <div class="form-field">
                <label for="display-name">Navn</label>
                <input id="display-name" @bind="model.DisplayName" @bind:event="oninput" autocomplete="name" maxlength="100" placeholder="Dit navn" />
                <ValidationMessage For="@(() => model.DisplayName)" />
            </div>

            <div class="form-field">
                <label for="registration-email">E-mail</label>
                <input id="registration-email" @bind="model.Email" @bind:event="oninput" autocomplete="email" inputmode="email" maxlength="254" placeholder="navn@eksempel.dk" />
                <ValidationMessage For="@(() => model.Email)" />
            </div>

            <div class="form-field">
                <label for="registration-password">Adgangskode</label>
                <input id="registration-password" type="password" @bind="model.Password" @bind:event="oninput" autocomplete="new-password" maxlength="128" placeholder="Mindst 12 tegn" />
                <ValidationMessage For="@(() => model.Password)" />
                <p class="field-hint">Brug små og store bogstaver, et tal og et specialtegn.</p>
            </div>

            <div class="form-field">
                <label for="confirm-password">Gentag adgangskode</label>
                <input id="confirm-password" type="password" @bind="model.ConfirmPassword" @bind:event="oninput" autocomplete="new-password" maxlength="128" placeholder="Gentag adgangskoden" />
                <ValidationMessage For="@(() => model.ConfirmPassword)" />
            </div>

            @if (errorMessage is not null)
            {
                <p class="notice notice-error" role="alert">@errorMessage</p>
            }

            <button class="button button-primary" type="submit" disabled="@isSubmitting">
                @(isSubmitting ? "Opretter…" : "Opret bruger")
            </button>
        </EditForm>
    </section>
</main>

@code {
    private readonly FitnessApp.Contracts.Authentication.RegistrationRequest model = new();
    private bool isSubmitting;
    private string? errorMessage;

    private async Task RegisterAsync()
    {
        if (isSubmitting)
        {
            return;
        }

        isSubmitting = true;
        errorMessage = null;

        try
        {
            var result = await Registration.RegisterAsync(model);
            if (result.IsSuccess)
            {
                Navigation.NavigateTo("/registrering-modtaget");
                return;
            }

            errorMessage = result.ErrorMessage;
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException)
        {
            errorMessage = "Der kunne ikke oprettes forbindelse. Prøv igen.";
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
