@page "/glemt-adgangskode"
@inject PasswordResetClient PasswordReset

<PageTitle>Glemt adgangskode</PageTitle>

<main class="auth-page" aria-labelledby="forgot-password-title">
    <section class="auth-panel">
        <a class="back-link" href="/login" aria-label="Tilbage til login">← Tilbage</a>

        @if (confirmationMessage is not null)
        {
            <div class="brand-mark brand-mark-success" aria-hidden="true">✓</div>
            <header class="auth-heading">
                <h1 id="forgot-password-title">Tjek din indbakke</h1>
                <p>Din anmodning er modtaget.</p>
            </header>
            <p class="notice notice-success" role="status">@confirmationMessage</p>
            <p class="confirmation-copy">Mailen kan tage et øjeblik. Tjek også din mappe med uønsket post.</p>
            <a class="button button-primary button-link" href="/login">Tilbage til login</a>
        }
        else
        {
            <BrandMark />
            <header class="auth-heading">
                <h1 id="forgot-password-title">Glemt adgangskode?</h1>
                <p>Indtast din e-mailadresse, så sender vi et sikkert resetlink.</p>
            </header>

            <EditForm Model="model" OnValidSubmit="RequestAsync" FormName="forgot-password" class="auth-form">
                <DataAnnotationsValidator />
                <div class="form-field">
                    <label for="forgot-email">E-mail</label>
                    <input id="forgot-email" @bind="model.Email" @bind:event="oninput" autocomplete="email" inputmode="email" maxlength="254" placeholder="navn@eksempel.dk" />
                    <ValidationMessage For="@(() => model.Email)" />
                </div>

                @if (errorMessage is not null)
                {
                    <p class="notice notice-error" role="alert">@errorMessage</p>
                }

                <button class="button button-primary" type="submit" disabled="@isSubmitting">
                    @(isSubmitting ? "Sender…" : "Send resetlink")
                </button>
            </EditForm>
        }
    </section>
</main>

@code {
    private readonly FitnessApp.Contracts.Authentication.ForgotPasswordRequest model = new();
    private bool isSubmitting;
    private string? confirmationMessage;
    private string? errorMessage;

    private async Task RequestAsync()
    {
        if (isSubmitting)
        {
            return;
        }

        isSubmitting = true;
        errorMessage = null;
        try
        {
            var result = await PasswordReset.RequestAsync(model);
            if (result.IsSuccess)
            {
                confirmationMessage = result.Message;
            }
            else
            {
                errorMessage = result.Message;
            }
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException)
        {
            errorMessage = "Der kunne ikke oprettes forbindelse. Prøv igen.";
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
