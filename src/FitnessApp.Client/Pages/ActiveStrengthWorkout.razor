@page "/styrke/{ProgramId:guid}/træninger/{WorkoutId:guid}/aktiv"
@attribute [Authorize]
@implements IDisposable
@using System.Globalization
@using FitnessApp.Client.Calendar
@using FitnessApp.Contracts.Strength
@using FitnessApp.Client.Strength
@inject StrengthProgramClient Programs
@inject NavigationManager Navigation

<PageTitle>@(workout?.WorkoutName ?? "Start træning")</PageTitle>

<NavigationLock OnBeforeInternalNavigation="ConfirmNavigationAsync" />

<main class="strength-app strength-active-page" aria-labelledby="active-title">
    <header class="strength-back-header">
        <a class="strength-icon-button" href="@BackUrl" aria-label="Afbryd og gå tilbage" title="Afbryd og gå tilbage">←</a>
        <div><h1 id="active-title">@(workout?.WorkoutName ?? "Træning")</h1><p class="strength-timer">@Elapsed</p></div>
        <span class="strength-header-spacer"></span>
    </header>
    @if (loading) { <p class="strength-feedback" role="status">Klargør træning…</p> }
    else if (error is not null) { <section class="strength-status-card" role="alert"><p>@error</p><button class="strength-secondary-button" @onclick="LoadAsync">Prøv igen</button></section> }
    else if (workout is not null)
    {
        <section class="strength-active-progress" aria-label="Træningsfremskridt"><div><strong>@completedCount af @logs.Count øvelser færdige</strong><span>@Progress%</span></div><div class="strength-progress-track"><span style="width: @Progress%"></span></div></section>
        <div class="strength-active-exercises">
            @foreach (var log in logs)
            {
                <article class="strength-active-card" @key="log.ProgramExerciseId">
                    <label class="strength-completion-row"><input type="checkbox" @bind="log.IsCompleted" /><span><strong>@log.Name</strong><small>@PerformanceLabel(log)</small></span></label>
                    @if (!string.IsNullOrWhiteSpace(log.Note))
                    {
                        <p class="strength-active-note">@log.Note</p>
                    }
                    <div class="strength-stepper-grid">
                        @if (log.DurationSeconds is { } duration)
                        {
                            <StrengthDurationInput Value="duration" ValueChanged="value => log.DurationSeconds = value" />
                        }
                        else
                        {
                            <div class="strength-stepper strength-weight-stepper">
                                <label for="@WeightInputId(log)">Vægt (kg)</label>
                                <div>
                                    <button type="button" aria-label="Sænk vægten" @onclick="() => ChangeWeight(log, -2.5m)">−</button>
                                    <input class="strength-weight-input" id="@WeightInputId(log)" type="text" inputmode="decimal"
                                           aria-invalid="@(log.RejectedWeight is not null ? "true" : null)"
                                           aria-describedby="@(log.RejectedWeight is not null ? WeightErrorId(log) : null)"
                                           @bind:get="log.RejectedWeight ?? FormatWeight(log.Weight)"
                                           @bind:set="value => SetWeight(log, value)" />
                                    <button type="button" aria-label="Øg vægten" @onclick="() => ChangeWeight(log, 2.5m)">+</button>
                                </div>
                                @if (log.RejectedWeight is not null)
                                {
                                    <p class="strength-field-error" id="@WeightErrorId(log)" role="alert">@WeightValidationMessage</p>
                                }
                            </div>
                        }
                        <div class="strength-stepper"><span>Sæt</span><div><button type="button" @onclick="() => ChangeSets(log, -1)">−</button><strong>@log.Sets</strong><button type="button" @onclick="() => ChangeSets(log, 1)">+</button></div></div>
                        @if (log.DurationSeconds is null)
                        {
                            <div class="strength-stepper"><span>Gentagelser</span><div><button type="button" @onclick="() => ChangeReps(log, -1)">−</button><strong>@log.Repetitions</strong><button type="button" @onclick="() => ChangeReps(log, 1)">+</button></div></div>
                        }
                    </div>
                </article>
            }
        </div>
        <footer class="strength-workout-footer">
            @if (saveError is not null) { <p class="strength-field-error" role="alert">@saveError</p> }
            <button class="strength-primary-button" @onclick="() => confirmFinish = true" disabled="@(busy || HasInvalidWeight)">Gem og afslut træning</button>
        </footer>
    }
    <ModalDialog IsOpen="@confirmFinish" Title="Afslut træning?" Description="Din gennemførte træning gemmes, så den kan bruges som seneste præstation næste gang." InitialFocusSelector="[data-modal-cancel]" DismissOnBackdrop="@(!busy)" DismissOnEscape="@(!busy)" ShowCloseButton="@(!busy)" OnDismiss="CloseFinish">
        <div class="app-modal-actions">
            <button class="strength-quiet-button" type="button" data-modal-cancel @onclick="CloseFinish" disabled="@busy">Bliv i træning</button>
            <button class="strength-primary-button" type="button" @onclick="CompleteAsync" disabled="@busy">@(busy ? "Gemmer…" : "Gem træning")</button>
        </div>
    </ModalDialog>
    <ModalDialog IsOpen="@discardWorkoutOpen" Title="Forlad uden at gemme?" Description="Dine indtastede værdier bliver ikke gemt."
                 InitialFocusSelector="[data-modal-cancel]" Destructive="true" OnDismiss="CloseDiscardWorkout">
        <div class="app-modal-actions">
            <button class="strength-quiet-button" type="button" data-modal-cancel @onclick="CloseDiscardWorkout">Bliv i træning</button>
            <button class="strength-danger-button" type="button" @onclick="DiscardWorkoutAndNavigate">Forlad uden at gemme</button>
        </div>
    </ModalDialog>
</main>

@code {
    [Parameter] public Guid ProgramId { get; set; }
    [Parameter] public Guid WorkoutId { get; set; }
    [SupplyParameterFromQuery(Name = "planlagt")] public string? RequestedOccurrenceDate { get; set; }
    [SupplyParameterFromQuery(Name = "maaned")] public string? RequestedMonth { get; set; }
    [SupplyParameterFromQuery(Name = "dato")] public string? RequestedDate { get; set; }
    private PlannedWorkoutResponse? workout;
    private List<WorkoutLog> logs = [];
    private bool loading;
    private bool busy;
    private bool confirmFinish;
    private bool discardWorkoutOpen;
    private bool hasActiveDraft;
    private Guid completionId;
    private string? pendingNavigationUrl;
    private string? error;
    private string? saveError;
    private DateTime startedAt;
    private Timer? timer;
    private static readonly NumberFormatInfo WeightNumberFormat = new() { NumberDecimalSeparator = "," };
    private const string WeightValidationMessage = "Indtast en vægt fra 0 til 1.000 kg med højst to decimaler.";
    private bool HasInvalidWeight => logs.Any(log => log.RejectedWeight is not null);

    private string BackUrl => CalendarRoute.BackPath(RequestedMonth, RequestedDate, $"/styrke/{ProgramId}");
    private DateOnly? ScheduledOccurrenceDate => DateOnly.TryParseExact(RequestedOccurrenceDate, "yyyy-MM-dd",
        CultureInfo.InvariantCulture, DateTimeStyles.None, out var date) ? date : null;

    private int completedCount => logs.Count(log => log.IsCompleted);
    private int Progress => logs.Count == 0 ? 0 : completedCount * 100 / logs.Count;
    private string Elapsed => startedAt == default ? "00:00" : (DateTime.UtcNow - startedAt).ToString(@"hh\:mm\:ss");

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
        timer?.Dispose();
        if (workout is not null) { startedAt = DateTime.UtcNow; timer = new Timer(_ => InvokeAsync(StateHasChanged), null, TimeSpan.Zero, TimeSpan.FromSeconds(1)); }
    }

    private async Task LoadAsync()
    {
        loading = true; error = null; saveError = null;
        var result = await Programs.GetWorkoutAsync(ProgramId, WorkoutId);
        loading = false; workout = result.Value; error = result.Error;
        logs = workout?.Exercises.Select(exercise => new WorkoutLog(exercise)).ToList() ?? [];
        if (workout is not null)
        {
            completionId = Guid.NewGuid();
            hasActiveDraft = true;
        }
    }

    private async Task CompleteAsync()
    {
        if (busy) return;
        if (HasInvalidWeight)
        {
            confirmFinish = false;
            return;
        }
        if (logs.Any(log => log.DurationSeconds is <= 0))
        {
            saveError = "Angiv en varighed på mindst ét sekund for tidsøvelser.";
            confirmFinish = false;
            return;
        }
        busy = true;
        var request = new CompleteWorkoutRequest
        {
            CompletionId = completionId,
            ScheduledOccurrenceDate = ScheduledOccurrenceDate,
            Exercises = logs.Select(log => new CompletedExerciseRequest
            {
                ProgramExerciseId = log.ProgramExerciseId, Name = log.Name, Weight = log.Weight,
                Sets = log.Sets, Repetitions = log.Repetitions, IsCompleted = log.IsCompleted,
                DurationSeconds = log.DurationSeconds
            }).ToList()
        };
        var result = await Programs.CompleteWorkoutAsync(ProgramId, WorkoutId, request);
        busy = false;
        if (result.Succeeded) { hasActiveDraft = false; Navigation.NavigateTo(BackUrl); return; }
        saveError = result.Error; confirmFinish = false;
    }

    private void CloseFinish() => confirmFinish = false;

    private Task ConfirmNavigationAsync(LocationChangingContext context)
    {
        if (!hasActiveDraft)
        {
            return Task.CompletedTask;
        }

        context.PreventNavigation();
        if (!busy)
        {
            pendingNavigationUrl = context.TargetLocation;
            discardWorkoutOpen = true;
        }

        return Task.CompletedTask;
    }

    private void CloseDiscardWorkout()
    {
        discardWorkoutOpen = false;
        pendingNavigationUrl = null;
    }

    private void DiscardWorkoutAndNavigate()
    {
        var url = pendingNavigationUrl ?? BackUrl;
        discardWorkoutOpen = false;
        pendingNavigationUrl = null;
        hasActiveDraft = false;
        Navigation.NavigateTo(url);
    }

    private static string WeightInputId(WorkoutLog log) => $"weight-{log.ProgramExerciseId}";
    private static string WeightErrorId(WorkoutLog log) => $"weight-error-{log.ProgramExerciseId}";
    private static void ChangeWeight(WorkoutLog log, decimal change)
    {
        log.Weight = Math.Clamp(log.Weight + change, 0, 1000);
        log.RejectedWeight = null;
    }

    private static void SetWeight(WorkoutLog log, string? input)
    {
        const NumberStyles styles = NumberStyles.AllowDecimalPoint | NumberStyles.AllowLeadingSign;
        var text = input?.Trim();
        if ((decimal.TryParse(text, styles, WeightNumberFormat, out var weight) ||
             decimal.TryParse(text, styles, CultureInfo.InvariantCulture, out weight)) &&
            weight is >= 0 and <= 1000 && decimal.Round(weight, 2) == weight)
        {
            log.Weight = weight;
            log.RejectedWeight = null;
        }
        else
        {
            log.RejectedWeight = input ?? "";
        }
    }
    private static void ChangeSets(WorkoutLog log, int change) => log.Sets = Math.Clamp(log.Sets + change, 1, 10);
    private static void ChangeReps(WorkoutLog log, int change) => log.Repetitions = Math.Clamp(log.Repetitions + change, 1, 30);
    private static string FormatWeight(decimal weight) => weight.ToString("0.##", WeightNumberFormat);
    private static string PerformanceLabel(WorkoutLog log)
    {
        if (log.PlannedDurationSeconds is { } plannedDuration)
        {
            return log.PreviousDurationSeconds is { } previousDuration
                ? $"Sidst: {log.PreviousSets} × {StrengthDurationInput.Format(previousDuration)}"
                : $"Plan: {log.PlannedSets} × {StrengthDurationInput.Format(plannedDuration)}";
        }

        return log.PreviousWeight is { } weight
            ? $"Sidst: {FormatWeight(weight)} kg · {log.PreviousSets} × {log.PreviousRepetitions}"
            : $"Plan: {FormatWeight(log.PlannedWeight)} kg · {log.PlannedSets} × {log.PlannedRepetitions}";
    }
    public void Dispose() => timer?.Dispose();

    private sealed class WorkoutLog(ActiveExerciseResponse exercise)
    {
        public Guid ProgramExerciseId { get; } = exercise.Id;
        public string Name { get; } = exercise.Name;
        public string? Note { get; } = exercise.Note;
        public decimal PlannedWeight { get; } = exercise.Weight;
        public int PlannedSets { get; } = exercise.Sets;
        public int PlannedRepetitions { get; } = exercise.Repetitions;
        public int? PlannedDurationSeconds { get; } = exercise.DurationSeconds;
        public decimal? PreviousWeight { get; } = exercise.PreviousWeight;
        public int? PreviousSets { get; } = exercise.PreviousSets;
        public int? PreviousRepetitions { get; } = exercise.PreviousRepetitions;
        public int? PreviousDurationSeconds { get; } = exercise.PreviousDurationSeconds;
        public decimal Weight { get; set; } = exercise.Weight > 0 ? exercise.Weight : exercise.PreviousWeight ?? exercise.Weight;
        public string? RejectedWeight { get; set; }
        public int Sets { get; set; } = exercise.Sets;
        public int Repetitions { get; set; } = exercise.Repetitions;
        public int? DurationSeconds { get; set; } = exercise.DurationSeconds;
        public bool IsCompleted { get; set; }
    }
}
