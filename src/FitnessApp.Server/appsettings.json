{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=App_Data/fitnessapp.db"
  },
  "Authentication": {
    "Jwt": {
      "Issuer": "FitnessApp",
      "Audience": "FitnessApp.Client",
      "AccessTokenMinutes": 15,
      "ClockSkewSeconds": 30
    },
    "LoginRateLimit": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "RegistrationRateLimit": {
      "PermitLimit": 5,
      "WindowSeconds": 300
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
